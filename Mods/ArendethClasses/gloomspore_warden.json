{
  "id": "MOD_GloomsporeWarden",
  "name": "Gloomspore Warden",
  "description": "Something grows in the dark between the hull plates, and it listens to you.\n\nSummoner built around spawning, bursting and colony size. Favors [SMT] and [PSI].",
  "archetype": "Intellect",
  "icon": "gloomspore_warden.png",
  "attributePriorities": {
    "Smarts": 4,
    "PsiPower": 2
  },
  "effects": [
    {
      "id": "Sporeload",
      "name": "Sporeload",
      "description": "The harm you do settles into you as spores. At three a Gloomcap sprouts beside you; at six the load breaks open and two more come up.",
      "duration": 20,
      "maxStacks": 6,
      "thresholds": [
        {
          "at": 3,
          "sound": "event:/Abilities/VoidPsyker/VoidPsyker_Horror_Spawn",
          "actions": [
            {
              "do": "summon",
              "to": "self",
              "creature": "PA_PASSIVE_VoidPsyker_Tentacles.tentaclePrefab",
              "summonName": "Gloomcap",
              "scaleStat": "PsiPower",
              "model": {
                "mesh": "models/gloomcap.obj",
                "texture": "models/gloomcap.png",
                "scale": 1.0,
                "glow": "#5cffb0",
                "glowStrength": 0.35,
                "pulse": 0.05,
                "wobble": 2,
                "randomYaw": true,
                "keepParticles": false
              },
              "summonGroup": "Gloomcap",
              "maxSummons": 4,
              "turns": 10,
              "effect": "@Capflesh"
            }
          ]
        }
      ],
      "burstAt": 6,
      "burstSound": "event:/Abilities/VoidPsyker/VoidPsyker_Horror_Spawn",
      "burstActions": [
        {
          "do": "summon",
          "to": "self",
          "creature": "PA_PASSIVE_VoidPsyker_Tentacles.tentaclePrefab",
          "summonName": "Gloomcap",
          "scaleStat": "PsiPower",
          "model": {
            "mesh": "models/gloomcap.obj",
            "texture": "models/gloomcap.png",
            "scale": 1.0,
            "glow": "#5cffb0",
            "glowStrength": 0.35,
            "pulse": 0.05,
            "wobble": 2,
            "randomYaw": true,
            "keepParticles": false
          },
          "summonGroup": "Gloomcap",
          "amount": 2,
          "maxSummons": 4,
          "turns": 10,
          "effect": "@Capflesh"
        }
      ]
    },
    {
      "id": "Gloomrot",
      "name": "Gloomrot",
      "description": "Rot that eats deeper with every layer. Gloomcaps burst into anything carrying it. If the bearer dies, its last breath feeds you.",
      "duration": 8,
      "debuff": true,
      "maxStacks": 8,
      "dot": {
        "type": "Bio",
        "min": 1,
        "max": 1
      },
      "stats": {
        "Dodge": -1
      },
      "resists": {
        "Bio": -2,
        "Void": -2
      },
      "vfx": "EFFECT_Xeno_Debuff_Green",
      "thresholds": [
        {
          "at": 6,
          "actions": [
            {
              "do": "effect",
              "effect": "CONFUSE",
              "turns": 2
            }
          ]
        }
      ],
      "onDeathActions": [
        {
          "do": "stamina",
          "to": "self",
          "amount": 4
        },
        {
          "do": "effect",
          "to": "self",
          "effect": "@Sporeload"
        }
      ]
    },
    {
      "id": "Capflesh",
      "name": "Capflesh",
      "description": "A short-lived growth. When it dies, whether it is cut down or simply runs out of time, it bursts through every rotting thing near it, harder for every other Gloomcap standing, and spreads the rot to its neighbours. Sometimes it leaves a healing haze behind. Few at a time, but each one is dense and dangerous. Rot and poison can't take hold in it, and the colony's own bursts pass through it.",
      "duration": -1,
      "stats": {
        "HealthMax": 20,
        "Armor": 3
      },
      "damageDealtMult": 1.5,
      "onDeathActions": [
        {
          "do": "chain",
          "jumps": 3,
          "radius": 2.5,
          "effect": "@Gloomrot",
          "actions": [
            {
              "do": "damage",
              "type": "Void",
              "min": 5,
              "max": 10,
              "scale": "Smarts",
              "scaleMult": 0.5,
              "ifTargetHas": "@Gloomrot",
              "bonusPerStack": 1,
              "stacksOf": "group:Gloomcap"
            },
            {
              "do": "effect",
              "effect": "@Gloomrot",
              "stacks": 2,
              "ifTargetHas": "@Gloomrot"
            }
          ]
        },
        {
          "do": "chain",
          "jumps": 2,
          "radius": 2,
          "actions": [
            {
              "do": "effect",
              "effect": "@Gloomrot"
            }
          ]
        },
        {
          "do": "heal",
          "to": "self",
          "amount": 4,
          "chance": 35
        }
      ],
      "immune": [
        "@Gloomrot",
        "#Poisoned",
        "EFFECT_Poison"
      ],
      "immuneToAllies": true
    },
    {
