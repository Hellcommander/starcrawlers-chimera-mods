    {
      "id": "Sporeward",
      "name": "Sporeward",
      "description": "The colony knows you. Your own rot, spores and poison can't take hold in you, you can't be fogged by them, and nothing the colony bursts or spits ever harms you.",
      "duration": -1,
      "immune": [
        "@Gloomrot",
        "#Poisoned",
        "EFFECT_Poison",
        "CONFUSE"
      ],
      "immuneToAllies": true
    }
  ],
  "tiers": [
    {
      "attributes": {
        "Smarts": 1
      },
      "newAbility": {
        "base": "Passive",
        "name": "Fertile Dark",
        "icon": "gloomspore_warden_t0.png",
        "description": "The harm you do settles into you as Sporeload, and some of it takes root in the target as Gloomrot. Every kill is good soil, and once in a while a blow knocks a weak Spitspore loose from the target: it drifts and spits for a few turns, then withers without bursting. The colony knows you: its rot, poison and spores never take hold in you, and nothing it bursts or spits harms you or its own caps.",
        "procs": [
          {
            "on": "turn",
            "when": {
              "lacks": "@Sporeward",
              "of": "self"
            },
            "actions": [
              {
                "do": "effect",
                "to": "self",
                "effect": "@Sporeward"
              }
            ]
          },
          {
            "on": "combatStart",
            "when": {
              "lacks": "@Sporeward",
              "of": "self"
            },
            "actions": [
              {
                "do": "effect",
                "to": "self",
                "effect": "@Sporeward"
              }
            ]
          },
          {
            "on": "hit",
            "chance": 40,
            "actions": [
              {
                "do": "effect",
                "to": "self",
                "effect": "@Sporeload"
              }
            ]
          },
          {
            "on": "hit",
            "chance": 30,
            "actions": [
              {
                "do": "effect",
                "effect": "@Gloomrot"
              }
            ]
          },
          {
            "on": "kill",
            "actions": [
              {
                "do": "effect",
                "to": "self",
                "effect": "@Sporeload"
              }
