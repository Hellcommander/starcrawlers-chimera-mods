{
  "id": "MOD_Miasmancer",
  "name": "Miasmancer",
  "description": "Chemists of the unclean air. They breathe the station's foul atmosphere like a tonic, wring the strength out of whatever they touch, and mix it mid-fight into clouds that eat everything inside them.\n\nDraw and compound: breathe and extract to refill your stamina, then spend it on area compounds. In time your blood shrugs off poison and acid entirely; mutants make better brewers.\n\nYour salts and clouds are reagents: fire, current, acid or frost from anywhere (your weapons, your crew, the enemy's own) meeting them sets off a reaction, and you learn more of them as you rank up. Scales with [SMT] and [PSI].",
  "archetype": "Guile",
  "icon": "miasmancer.png",
  "attributePriorities": { "Smarts": 3, "PsiPower": 3, "Agility": 1 },
  "effects": [
    { "id": "Corroded", "name": "Salt-Corroded", "debuff": true, "duration": 4, "maxStacks": 4, "stats": { "Armor": -2 }, "resists": { "Bio": -5 },
      "description": "Rust salts eating into its plating and hide." },
    { "id": "Choking", "name": "Choking", "debuff": true, "duration": 2, "stats": { "RangedAccuracy": -10, "Dodge": -5 },
      "description": "Coughing up whatever you mixed." },
    { "id": "Inured", "name": "Mithridatic Blood", "duration": 2,
      "description": "Years of breathing your own brews: poison and acid no longer take.",
      "immune": [ "#Poisoned", "EFFECT_Poison", "EFFECT_Acid", "@Choking" ] }
  ],
  "reactions": [
    {"name": "Full Compound", "needs": ["@Corroded", "#Poisoned", "@Choking"], "keep": ["@Corroded"], "rank": 7, "when": {"value": "stacks:@Corroded", "of": "target", "atLeast": 2}, "description": "the choke sets everything you mixed off at once: the salts stay, and a cloud of poison and salt hangs over everyone near", "vfx": "PA_Prototype_Thunderclap.impactParticle@0.5", "sound": "sfx/mia_grand.wav", "actions": [{"do": "damage", "type": "Bio", "min": 6, "max": 10, "scale": "Smarts+PsiPower", "scaleMult": 0.3}, {"do": "silence", "turns": 1}, {"do": "field", "fieldName": "Compound Cloud", "turns": 2, "radius": 2, "affects": "enemies", "look": "HAZARD_Gas@0.6", "actions": [{"do": "effect", "effect": "#Poisoned"}, {"do": "effect", "effect": "@Corroded"}]}]},
    { "name": "Rust Flash", "needs": [ "@Corroded", "EFFECT_Fire|#Burning" ], "description": "the rust salts flare white-hot against the plating",
      "vfx": "PA_Elementalist_MagmaBurst.impactParticle@0.5", "sound": "sfx/mia_bloom.wav",
      "actions": [ { "do": "damage", "type": "Fire", "min": 5, "max": 9, "scale": "Smarts+PsiPower", "scaleMult": 0.25, "trueDamage": true }, { "do": "hazard", "hazard": "HAZARD_Fire_Mini" } ] },
    { "name": "Salt Cough", "needs": [ "@Corroded", "@Choking" ], "keep": [ "@Corroded" ], "rank": 3, "radius": 1.6, "description": "it coughs the salts over everyone beside it",
      "vfx": "PA_Engineer_Spidermine.PS_explode_bio@0.35", "sound": "audio_licensed/mia_salt.wav",
      "actions": [ { "do": "effect", "effect": "@Corroded" }, { "do": "damage", "type": "Bio", "min": 2, "max": 4, "scale": "Smarts+PsiPower", "scaleMult": 0.15 } ] },
    { "name": "Salt Etch", "needs": [ "@Corroded", "EFFECT_Acid" ], "rank": 4, "description": "acid and rust salts eat straight through",
      "vfx": "PA_Engineer_Spidermine.PS_explode_bio@0.4", "sound": "audio_licensed/mia_salt.wav",
      "actions": [ { "do": "damage", "type": "Bio", "min": 4, "max": 8, "scale": "Smarts+PsiPower", "scaleMult": 0.25, "trueDamage": true }, { "do": "effect", "effect": "#Weakened", "turns": 2 } ] },
    { "name": "Galvanic Rot", "needs": [ "@Corroded", "EFFECT_Shock|#Shocked" ], "rank": 4, "description": "the current runs through the rust to the next one along",
      "vfx": "PA_Elementalist_ChainLightning.shockImpact", "sound": "sfx/mia_extract.wav",
      "actions": [ { "do": "chain", "jumps": 2, "radius": 3, "actions": [ { "do": "damage", "type": "Bio", "min": 3, "max": 6, "scale": "Smarts+PsiPower", "scaleMult": 0.2 }, { "do": "effect", "effect": "@Corroded" } ] } ] },
    { "name": "Choke Point", "needs": [ "@Choking", "#Poisoned" ], "keep": [ "#Poisoned" ], "rank": 5, "chance": 50, "chancePerRank": 5, "description": "it chokes on the poison and can't get a technique out",
      "vfx": "PA_Engineer_Spidermine.PS_explode_bio@0.3", "sound": "sfx/mia_draw.wav",
      "actions": [ { "do": "silence", "turns": 1 }, { "do": "damage", "type": "Bio", "min": 3, "max": 5, "scale": "Smarts+PsiPower", "scaleMult": 0.2 } ] },
    { "name": "Toxic Smoke", "needs": [ "#Poisoned", "EFFECT_Fire|#Burning" ], "keep": [ "#Poisoned" ], "rank": 6, "description": "the poison burns off into a choking smoke",
      "vfx": "PA_Engineer_Spidermine.PS_explode_bio@0.5", "sound": "sfx/mia_mist.wav",
      "actions": [ { "do": "damage", "type": "Fire", "min": 2, "max": 4, "scale": "Smarts+PsiPower", "scaleMult": 0.15 },
                   { "do": "field", "fieldName": "Toxic Smoke", "turns": 2, "radius": 1.5, "affects": "enemies", "look": "HAZARD_Gas@0.6", "actions": [ { "do": "effect", "effect": "@Choking" }, { "do": "effect", "effect": "#Poisoned" } ] } ] },
    { "name": "Frozen Lungs", "needs": [ "@Choking", "EFFECT_Chill|#Chilled" ], "rank": 6, "description": "the breath freezes in its chest",
      "vfx": "PA_Elementalist_FrigidBlast.impactParticle@0.5", "sound": "sfx/mia_draw.wav",
      "actions": [ { "do": "stun", "turns": 1 }, { "do": "damage", "type": "Cryo", "min": 3, "max": 6, "scale": "Smarts+PsiPower", "scaleMult": 0.2 } ] },
    {"name": "Frost Scale", "needs": ["@Corroded", "EFFECT_Chill|#Chilled"], "rank": 3, "description": "frost gets into the salt-eaten plating and cracks it open", "vfx": "PA_Elementalist_FrigidBlast.impactParticle@0.5", "sound": "audio_licensed/mia_salt.wav", "actions": [{"do": "damage", "type": "Cryo", "min": 3, "max": 6, "scale": "Smarts+PsiPower", "scaleMult": 0.2}, {"do": "effect", "effect": "#Exposed", "turns": 2}]},
    {"name": "Backdraft", "needs": ["@Choking", "EFFECT_Fire|#Burning"], "rank": 5, "description": "it gasps and draws the flame into its lungs", "vfx": "PA_Elementalist_MagmaBurst.impactParticle@0.4", "sound": "sfx/mia_draw.wav", "actions": [{"do": "damage", "type": "Fire", "min": 3, "max": 6, "scale": "Smarts+PsiPower", "scaleMult": 0.2, "trueDamage": true}, {"do": "effect", "effect": "#Burning", "stacks": 2}]},
    {"name": "Rust Blood", "needs": ["@Corroded", "#Gashed"], "keep": ["@Corroded"], "rank": 5, "description": "the salts get into the open wounds and the blood carries them; the bleeding stops, salted", "vfx": "PA_Engineer_Spidermine.PS_explode_bio@0.35", "sound": "audio_licensed/mia_salt.wav", "actions": [{"do": "effect", "effect": "#Poisoned", "stacks": 2}, {"do": "effect", "effect": "#Weakened", "turns": 2}]},
    {"name": "Venom Etch", "needs": ["#Poisoned", "EFFECT_Acid"], "rank": 8, "description": "the acid carries the poison through whatever was keeping it out", "vfx": "PA_Engineer_Spidermine.PS_explode_bio@0.5", "sound": "audio_licensed/mia_salt.wav", "actions": [{"do": "dispel", "amount": 1}, {"do": "damage", "type": "Bio", "min": 5, "max": 9, "scale": "Smarts+PsiPower", "scaleMult": 0.3, "trueDamage": true}, {"do": "effect", "effect": "#Weakened", "turns": 3}]}
  ],
  "tiers": [
    {
      "attributes": { "Smarts": 1 },
      "newAbility": {
        "base": "Passive", "name": "Air Sieve", "icon": "miasmancer_t0.png",
        "description": "You breathe the station in and keep what's useful: a little stamina every turn of a fight, and more from everything you kill.",
        "procs": [
          { "on": "turn", "when": { "inCombat": true }, "actions": [ { "do": "stamina", "to": "self", "amount": 2 } ] },
          { "on": "kill", "actions": [ { "do": "stamina", "to": "self", "amount": 5 } ] }
        ]
      }
    },
    {
      "attributes": { "PsiPower": 1 },
      "newAbility": {
        "base": "Bolt", "name": "Breath of the Station", "icon": "miasmancer_t1.png", "staminaCost": 2,
        "description": "Pull a lungful of foul air out of the room and spit it at someone. It stings, and what you keep back leaves you stronger than before.",
        "sound": "sfx/mia_draw.wav", "impactVfx": "PA_Engineer_Spidermine.PS_explode_bio@0.25",
        "actions": [
          { "do": "damage", "type": "Bio", "min": 2, "max": 4, "scale": "Smarts+PsiPower", "scaleMult": 0.2, "perRank": 1 },
          { "do": "stamina", "to": "self", "amount": 6 }
        ],
        "perk": { "name": "Deep Lungs", "description": "The air around anything poisoned is the richest in the room, and you know how to draw it.",
          "addActions": [ { "do": "stamina", "to": "self", "amount": 1, "bonusPerStack": 2, "stacksOf": "#Poisoned", "stacksFrom": "target", "stacksUsed": 4 } ] }
      }
    },
    {
      "attributes": { "Smarts": 1 },
      "newAbility": {
        "base": "Blast", "name": "Caustic Mist", "synergyPenalty": { "stamina": 1 }, "icon": "miasmancer_t2.png", "range": 6, "radius": 2, "staminaCost": 16, "cooldown": 3,
        "description": "Let a held breath go over a group. It poisons whoever breathes it, and hangs there a while.",
        "sound": "sfx/mia_mist.wav", "areaVfx": "PA_Engineer_Spidermine.PS_explode_bio@0.5",
        "actions": [
          { "do": "damage", "type": "Bio", "min": 3, "max": 6, "scale": "Smarts+PsiPower", "scaleMult": 0.25, "perRank": 1 },
          { "do": "effect", "effect": "#Poisoned", "stacks": 2 },
          { "do": "field", "fieldName": "Caustic Mist", "turns": 3, "radius": 2, "affects": "enemies", "look": "HAZARD_Gas@0.6",
            "actions": [ { "do": "effect", "effect": "#Poisoned" }, { "do": "effect", "effect": "@Choking" } ] }
        ],
        "perk": { "name": "Lingering Mist", "description": "Whatever dies poisoned breathes its last on whoever stands next to it.",
          "addProcs": [ { "on": "kill", "radius": 2, "when": { "has": "#Poisoned", "of": "victim" }, "actions": [ { "do": "effect", "effect": "#Poisoned", "stacks": 2 }, { "do": "effect", "effect": "@Choking" } ] } ] }
      }
    },
    {
      "attributes": { "PsiPower": 1 },
      "newAbility": {
        "base": "Bolt", "name": "Extract", "icon": "miasmancer_t3.png", "range": 4, "staminaCost": 8, "cooldown": 2,
        "description": "Reach in with your mind and pull out what it's made of, flesh or machine. It hurts them a great deal more than it hurts you, and the strength you take is yours.",
        "sound": "sfx/mia_extract.wav", "impactVfx": "PA_Psykonics_Temporal.castParticle@0.4",
        "actions": [
          { "do": "damage", "type": "Bio", "min": 3, "max": 5, "scale": "Smarts+PsiPower", "scaleMult": 0.25, "perRank": 1 },
          { "do": "stamina", "to": "self", "amount": 10 },
          { "do": "heal", "to": "self", "amount": 4, "ifSkill": "SKILLTREE_ChaoticMutant" }
        ],
        "perk": { "name": "Deeper Extraction", "description": "You come away with what was holding it up: whatever protects it goes, and its strength with it.",
          "addActions": [ { "do": "dispel", "amount": 1 }, { "do": "effect", "effect": "#Weakened" } ] }
      }
    },
    {
      "attributes": { "Smarts": 1 },
      "newAbility": {
        "base": "Blast", "name": "Ichor Bloom", "icon": "miasmancer_t4.png", "range": 6, "radius": 1.6, "staminaCost": 22, "cooldown": 4,
        "description": "Blood and foul air mixed above them: a red bloom that rots flesh and leaves them weak.",
        "sound": "sfx/mia_bloom.wav", "areaVfx": "PA_Engineer_Spidermine.PS_explode_bio@0.6",
        "actions": [
          { "do": "damage", "type": "Bio", "min": 6, "max": 10, "scale": "Smarts+PsiPower", "scaleMult": 0.35, "perRank": 2 },
          { "do": "effect", "effect": "#Weakened" }, { "do": "effect", "effect": "#Poisoned", "stacks": 2 }
        ],
        "perk": { "name": "Arterial Bloom", "description": "Everyone it catches sprays, and the spray rots the next one along.",
          "addActions": [ { "do": "chain", "jumps": 1, "radius": 3, "actions": [ { "do": "effect", "effect": "#Gashed" }, { "do": "effect", "effect": "#Poisoned" } ] } ] }
      }
    },
    {
      "attributes": { "PsiPower": 1 },
      "newAbility": {
        "base": "Bolt", "name": "Rust Salt Cloud", "icon": "miasmancer_t5.png", "range": 4, "shape": "cone", "angle": 70, "staminaCost": 22, "cooldown": 4,
        "description": "Blow a cloud of rust salts out on one breath. The cloud eats plating and hide alike.",
        "sound": "audio_licensed/mia_salt.wav", "impactVfx": "PA_DualWield_SinisterStrike.impactEffect@0.3",
        "actions": [
          { "do": "damage", "type": "Bio", "min": 4, "max": 8, "scale": "Smarts+PsiPower", "scaleMult": 0.3, "perRank": 2 },
          { "do": "effect", "effect": "@Corroded", "stacks": 2 }
        ],
        "perk": { "name": "Finer Salts", "description": "Ground this fine, the salts find every seam.", "addActions": [ { "do": "effect", "effect": "@Corroded" } ] }
      }
    },
    {
      "attributes": { "Smarts": 1 },
      "newAbility": {
        "base": "Blast", "name": "Grand Compound", "icon": "miasmancer_t6.png", "range": 6, "radius": 2.5, "staminaCost": 36, "cooldown": 9,
        "description": "Everything at once: foul air to carry it, blood and rust salts to make it bite. It leaves you gasping and them worse.",
        "sound": "sfx/mia_grand.wav", "areaVfx": "PA_Prototype_Thunderclap.impactParticle@0.5",
        "actions": [
          { "do": "damage", "type": "Bio", "min": 12, "max": 18, "scale": "Smarts+PsiPower", "scaleMult": 0.35, "perRank": 2 },
          { "do": "effect", "effect": "@Corroded", "stacks": 3 },
          { "do": "effect", "effect": "#Poisoned", "stacks": 3 }, { "do": "effect", "effect": "@Choking" },
          { "do": "heal", "to": "self", "amount": 8, "scale": "Smarts", "scaleMult": 0.4, "ifSkill": "SKILLTREE_ChaoticMutant" }
        ],
        "perk": { "name": "Saturated Compound", "description": "Plating already eaten through gives way all at once: the salts burn off and it seizes where it stands.",
          "addActions": [ { "do": "if", "when": { "value": "stacks:@Corroded", "of": "target", "atLeast": 4 }, "then": [ { "do": "purge", "effect": "@Corroded" }, { "do": "stun", "turns": 1 } ] } ] }
      }
    },
    {
      "attributes": { "PsiPower": 1, "Toughness": 1 },
      "newAbility": {
        "base": "Passive", "name": "Mithridatic Blood", "icon": "miasmancer_t7.png",
        "description": "You have breathed enough of your own brews that poison and acid simply don't take any more, yours or anyone's, and walking through your own clouds costs you nothing.",
        "procs": [
          { "on": "turn", "actions": [ { "do": "effect", "to": "self", "effect": "@Inured" }, { "do": "purge", "to": "self", "effect": "#Poisoned" }, { "do": "purge", "to": "self", "effect": "EFFECT_Poison" }, { "do": "purge", "to": "self", "effect": "EFFECT_Acid" } ] },
          { "on": "combatStart", "actions": [ { "do": "effect", "to": "self", "effect": "@Inured" } ] }
        ]
      }
    },
    {
      "attributes": { "Smarts": 1, "PsiPower": 1 },
      "newAbility": {
        "base": "Passive", "name": "Saturated Air", "icon": "miasmancer_t8.png",
        "description": "Your clouds feed you back. Anything that dies poisoned gives you more stamina, and every third compound you mix hands some of its cost back.",
        "procs": [
          { "on": "kill", "when": { "has": "#Poisoned", "of": "victim" }, "actions": [ { "do": "stamina", "to": "self", "amount": 4 } ] },
          { "on": "cast", "match": "Grand Compound", "every": 3, "actions": [ { "do": "stamina", "to": "self", "amount": 18 } ] },
          { "on": "cast", "match": "Ichor Bloom", "every": 3, "actions": [ { "do": "stamina", "to": "self", "amount": 11 } ] },
          { "on": "cast", "match": "Rust Salt Cloud", "every": 3, "actions": [ { "do": "stamina", "to": "self", "amount": 11 } ] }
        ]
      }
    }
  ]
}
