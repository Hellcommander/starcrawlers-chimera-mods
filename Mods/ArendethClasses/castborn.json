{
  "id": "MOD_Castborn",
  "name": "Castborn",
  "description": "Not born, poured. Castborn are walking foundry castings: no blood to poison, plating that reseals itself, and a hand that is a socket rather than a hand.\n\nModular construct tank with self-repair and poured allies. Favors [TGH] and [STR].",
  "archetype": "Muscle",
  "icon": "castborn.png",
  "attributePriorities": {
    "Toughness": 4,
    "Strength": 2,
    "HealthMax": 1
  },
  "effects": [
    {
      "id": "Mending",
      "name": "Self-Mending",
      "description": "Molten seams are knitting your plates back together.",
      "duration": 4,
      "hot": 3,
      "stats": {
        "Armor": 1
      }
    },
    {
      "id": "Slagged",
      "name": "Slagged",
      "description": "Coated in cooling slag. Heavy and hot.",
