      },
      "dot": {
        "type": "Fire",
        "min": 1,
        "max": 2
      }
    },
    {
      "id": "RamFitting",
      "name": "Ram Fitting",
      "description": "A piston ram is bolted into your hand socket. Your Ingot Fist lands heavier and can drop what it hits. It stays fitted until you swap it out.",
      "duration": -1,
      "group": "HandFitting",
      "damageDealtMult": 1.15,
      "stats": {
        "Strength": 2,
        "Dodge": -5
      }
    },
    {
      "id": "WardFitting",
      "name": "Ward Fitting",
      "description": "A broad ward plate is bolted into your hand socket. You shrug off blows, and your Ingot Fist shoves foes off you while you brace behind it. It stays fitted until you swap it out.",
      "duration": -1,
      "group": "HandFitting",
      "damageTakenMult": 0.75,
      "damageDealtMult": 0.9,
      "stats": {
        "Armor": 3,
        "Dodge": -5
      }
    },
    {
      "id": "Castbond",
      "name": "Castbond",
      "description": "Poured from the same melt as its maker: thick-plated and slow to break.",
      "duration": -1,
      "damageTakenMult": 0.8,
      "stats": {
        "Armor": 3
      }
    },
    {
      "id": "Siege",
