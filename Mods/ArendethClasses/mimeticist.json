    {
      "attributes": { "Toughness": 1 },
      "newAbility": {
        "base": "Passive", "name": "Second Skin", "icon": "mimeticist_t8.png",
        "description": "Coming back to yourself is easier every time. Whenever a borrowed shape ends you recover a little health and stamina, and kills made in a borrowed shape feed you more.",
        "procs": [
