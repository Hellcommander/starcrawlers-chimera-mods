{
  "id": "MOD_Mimeticist",
  "name": "Mimeticist",
  "description": "Xenobiologists who stopped cataloguing the station's fauna and started wearing it. Tag a creature, feed on it when it dies, and spend your strength to rebuild yourself in the shape of the things that live in the vents, the sumps and the reactor shafts.\n\nHunt and shift: each form is a whole new body with its own skills (a stalking panther, a hound that calls its pack, a shelled hullback, a grabbing sump lurker, a web-spinning weaver and a reactor wyrm). Shed the shape whenever you like; coming back gives a little of it back. Scales with [SMT]; favors [TGH].",
  "archetype": "Intellect",
  "icon": "mimeticist.png",
  "attributePriorities": { "Smarts": 4, "Toughness": 2 },
  "effects": [
    { "id": "Tagged", "name": "Sample-Tagged", "debuff": true, "duration": 6,
      "description": "A sampling dart is lodged in it. If it dies with the dart in, what it was made of feeds you.",
      "onDeathActions": [ { "do": "stamina", "to": "self", "amount": 6 } ] },

    { "id": "FormPanther", "name": "Vent Panther", "group": "MimeticForm", "duration": 10, "icon": "mimeticist_t2.png",
      "description": "Long, low and quiet: a vent stalker that bleeds what it catches and is gone before it falls.",
      "stats": { "Dodge": 15, "Stealth": 10, "Agility": 3 },
      "kit": [
        { "base": "Bolt", "name": "Vent Spring", "range": 4, "staminaCost": 6, "cooldown": 2, "description": "Spring onto it, claws first.",
          "impactVfx": "PA_DualWield_SinisterStrike.impactEffect", "sound": "audio_licensed/mim_claw.wav",
          "actions": [ { "do": "leap" }, { "do": "damage", "type": "Slashing", "min": 3, "max": 6, "scale": "Smarts", "scaleMult": 0.35, "perRank": 1 },
                       { "do": "effect", "effect": "#Gashed", "stacks": 2 } ] },
        { "base": "Strike", "name": "Gut Rend", "staminaCost": 8, "cooldown": 3, "description": "Open every wound it already has.",
          "sound": "audio_licensed/mim_claw.wav",
          "actions": [ { "do": "damage", "type": "Slashing", "min": 2, "max": 4, "scale": "Smarts", "scaleMult": 0.3, "perRank": 1,
                         "bonusPerStack": 3, "stacksOf": "#Gashed", "consumeStacks": true } ] },
        { "base": "Buff", "name": "Into the Vents", "staminaCost": 6, "cooldown": 6, "description": "Slip into the dark for a breath. Your next blows land hard.",
          "actions": [ { "do": "effect", "to": "self", "effect": "@Unseen" } ] },
        { "base": "Bolt", "name": "Ghost Pounce", "ifSkill": "SKILLTREE_Cyberninja|SKILLTREE_Acrobatics", "range": 5, "staminaCost": 8, "cooldown": 5, "description": "Your old training and the panther agree: land, strike, and be gone again.", "sound": "audio_licensed/mim_claw.wav", "actions": [ { "do": "leap" }, { "do": "damage", "type": "Slashing", "min": 4, "max": 7, "scale": "Smarts", "scaleMult": 0.35, "perRank": 1 }, { "do": "effect", "effect": "#Gashed", "stacks": 2 }, { "do": "effect", "to": "self", "effect": "@Unseen" } ] },
        { "base": "Bolt", "name": "Stormclaw Spring", "ifSkill": "MOD_Fulgurant", "range": 5, "staminaCost": 8, "cooldown": 4, "description": "The lightning in you rides the leap: the claws land with a bolt in them and leave a Stepped Leader behind.", "sound": "audio_licensed/fulg_step.wav", "impactVfx": "PA_Elementalist_ChainLightning.shockImpact", "actions": [ { "do": "leap" }, { "do": "damage", "type": "Shock", "min": 3, "max": 6, "scale": "Smarts+PsiPower", "scaleMult": 0.25, "perRank": 1 }, { "do": "effect", "effect": "#Gashed" }, { "do": "effect", "effect": "MOD_Fulgurant@Leader", "stacks": 2 } ] },
        { "base": "Buff", "name": "Shed the Shape", "staminaCost": 0, "cooldown": 0, "description": "Let the borrowed body go.",
          "actions": [ { "do": "purge", "to": "self", "effect": "@FormPanther" } ] }
      ] },
    { "id": "Unseen", "name": "In the Vents", "duration": 2, "damageDealtMult": 1.4,
      "description": "Gone into the dark. Hard to find, and what finds them first is your claws.",
      "stats": { "Stealth": 25, "Dodge": 25 } },

    { "id": "FormHound", "name": "Scrap Hound", "group": "MimeticForm", "duration": 10, "icon": "mimeticist_t3.png",
      "description": "A rangy junkyard hunter that runs prey down with its pack, every bite slowing it further.",
      "stats": { "Agility": 2, "Strength": 2, "Dodge": 5 },
      "kit": [
        { "base": "Strike", "name": "Hamstring Bite", "staminaCost": 6, "cooldown": 0, "description": "Go for the legs.",
          "sound": "audio_licensed/mim_bite.wav",
          "actions": [ { "do": "damage", "type": "Piercing", "min": 3, "max": 5, "scale": "Smarts", "scaleMult": 0.3, "perRank": 1 },
                       { "do": "effect", "effect": "#Gashed" }, { "do": "effect", "effect": "SLOW", "turns": 2 } ] },
        { "base": "Buff", "name": "Call the Pack", "staminaCost": 10, "cooldown": 8, "description": "Howl down the corridor. A muttwolf answers and hunts beside you.",
          "sound": "sfx/mim_howl.wav",
          "actions": [ { "do": "summon", "creature": "MUTT_WOLF", "summonName": "Packmate", "summonGroup": "Packmate", "amount": 1, "maxSummons": 1, "turns": 12 } ] },
        { "base": "Bolt", "name": "Run It Down", "range": 5, "staminaCost": 10, "cooldown": 4, "description": "Close the distance at a sprint. The more of the pack on it, the harder you hit.",
          "sound": "audio_licensed/mim_bite.wav",
          "actions": [ { "do": "leap" }, { "do": "damage", "type": "Piercing", "min": 3, "max": 6, "scale": "Smarts", "scaleMult": 0.35, "perRank": 1,
                         "bonusPerStack": 3, "stacksOf": "summons" } ] },
        { "base": "Strike", "name": "Hellmutt Bite", "ifSkill": "SKILLTREE_Pyromaniac", "staminaCost": 8, "cooldown": 2, "description": "A firebug's hound breathes through its teeth.", "sound": "audio_licensed/mim_bite.wav", "impactVfx": "PA_Elementalist_MagmaBurst.impactParticle@0.3", "actions": [ { "do": "damage", "type": "Fire", "min": 3, "max": 6, "scale": "Smarts", "scaleMult": 0.35, "perRank": 1 }, { "do": "effect", "effect": "#Burning", "stacks": 2 } ] },
        { "base": "Buff", "name": "Shed the Shape", "staminaCost": 0, "cooldown": 0, "description": "Let the borrowed body go.",
          "actions": [ { "do": "purge", "to": "self", "effect": "@FormHound" } ] }
      ] },

    { "id": "FormHullback", "name": "Hullback", "group": "MimeticForm", "duration": 10, "icon": "mimeticist_t4.png",
      "description": "A plated bulk that lives in the cargo holds. Slow, but almost nothing gets through, and it goes through everything.",
      "damageTakenMult": 0.65, "stats": { "Armor": 6, "Toughness": 3, "Dodge": -10 },
      "kit": [
        { "base": "Bolt", "target": "floor", "name": "Plated Rush", "range": 4, "shape": "line", "staminaCost": 10, "cooldown": 4,
          "description": "Charge straight through the line, flattening anything in it.", "sound": "audio_licensed/mim_stomp.wav",
          "impactVfx": "PA_Shieldbearer_Charge.impactParticle",
          "actions": [ { "do": "teleport" }, { "do": "damage", "type": "Crushing", "min": 4, "max": 7, "scale": "Smarts", "scaleMult": 0.35, "perRank": 1 },
                       { "do": "knockback", "amount": 1 }, { "do": "stun", "turns": 1, "chance": 30 } ] },
        { "base": "Nova", "name": "Bellow", "radius": 2, "staminaCost": 10, "cooldown": 6, "description": "A roar from deep in the shell that rattles every skull near you.",
          "sound": "sfx/mim_bellow.wav",
          "actions": [ { "do": "stun", "turns": 1 }, { "do": "effect", "effect": "#Reeling" } ] },
        { "base": "Buff", "name": "Shell Down", "radius": 3, "staminaCost": 8, "cooldown": 7, "description": "Pull everything in under the plates and dare them to try.",
          "actions": [ { "do": "effect", "to": "self", "effect": "@Shelled" }, { "do": "taunt", "turns": 2 } ] },
        { "base": "Buff", "name": "Bulwark Plates", "ifSkill": "SKILLTREE_Shieldbearer", "radius": 3, "staminaCost": 8, "cooldown": 8, "description": "A shieldbearer knows how to wear armour: lock the plates into a wall and draw every eye to it.", "sound": "audio_licensed/mim_stomp.wav", "actions": [ { "do": "shield", "to": "self", "amount": 12, "scale": "Smarts", "scaleMult": 0.6 }, { "do": "taunt", "turns": 2 } ] },
        { "base": "Buff", "name": "Shed the Shape", "staminaCost": 0, "cooldown": 0, "description": "Let the borrowed body go.",
          "actions": [ { "do": "purge", "to": "self", "effect": "@FormHullback" } ] }
      ] },
    { "id": "Shelled", "name": "Shelled", "duration": 2, "damageTakenMult": 0.4, "root": true,
      "description": "Withdrawn into the plates: barely anything gets through, but you aren't going anywhere." },

    { "id": "FormLurker", "name": "Sump Lurker", "group": "MimeticForm", "duration": 10, "icon": "mimeticist_t5.png",
      "description": "Something from the flooded sumps: a long sticky tongue, a crushing jaw, and a hide that poisons whatever bites it.",
      "stats": { "HealthRegen": 2, "Toughness": 2 }, "resists": { "Bio": 25 },
      "procs": [ { "on": "hurt", "chance": 50, "actions": [ { "do": "effect", "to": "attacker", "effect": "#Poisoned" } ] } ],
      "kit": [
        { "base": "Bolt", "name": "Tongue Snare", "range": 5, "staminaCost": 8, "cooldown": 3, "description": "Lash it and reel it in.",
          "sound": "audio_licensed/mim_tongue.wav",
          "actions": [ { "do": "pull", "amount": 3 }, { "do": "damage", "type": "Bio", "min": 2, "max": 4, "scale": "Smarts", "scaleMult": 0.3, "perRank": 1 },
                       { "do": "effect", "effect": "#Poisoned" } ] },
        { "base": "Strike", "name": "Drowning Roll", "staminaCost": 12, "cooldown": 5, "description": "Clamp on and roll, the way it drowns things in the sump.",
          "sound": "audio_licensed/mim_bite.wav",
          "actions": [ { "do": "stun", "turns": 2 }, { "do": "damage", "type": "Crushing", "min": 5, "max": 9, "scale": "Smarts", "scaleMult": 0.45, "perRank": 2,
                         "bonusPerStack": 2, "stacksOf": "#Poisoned" } ] },
        { "base": "Bolt", "name": "Undertow Tongue", "ifSkill": "MOD_Tidewright", "range": 6, "staminaCost": 8, "cooldown": 4, "description": "A hydromancer's lurker drags its prey in on a rush of brine, soaking it through.", "sound": "audio_licensed/mim_tongue.wav", "actions": [ { "do": "pull", "amount": 4 }, { "do": "damage", "type": "Crushing", "min": 2, "max": 5, "scale": "Smarts", "scaleMult": 0.3, "perRank": 1 }, { "do": "effect", "effect": "MOD_Tidewright@Soaked", "stacks": 3 } ] },
        { "base": "Buff", "name": "Shed the Shape", "staminaCost": 0, "cooldown": 0, "description": "Let the borrowed body go.",
          "actions": [ { "do": "purge", "to": "self", "effect": "@FormLurker" } ] }
      ] },

    { "id": "FormWeaver", "name": "Lattice Weaver", "group": "MimeticForm", "duration": 10, "icon": "mimeticist_t6.png",
      "description": "A long-legged weaver from the cable shafts: webs to hold them, venom to finish them, and the ceiling to strike from.",
      "stats": { "Dodge": 10, "Agility": 2 },
      "kit": [
        { "base": "Blast", "name": "Web Spit", "range": 5, "radius": 1.5, "staminaCost": 8, "cooldown": 4, "description": "Spray a sticky web over a patch of deck.",
          "sound": "audio_licensed/mim_web.wav",
          "actions": [ { "do": "effect", "effect": "@Webbed" },
                       { "do": "field", "fieldName": "Lattice Web", "turns": 3, "radius": 1.5, "affects": "enemies", "look": "HAZARD_Holosmoke@0.4",
                         "actions": [ { "do": "effect", "effect": "@Webbed" } ] } ] },
        { "base": "Strike", "name": "Venom Fang", "staminaCost": 6, "cooldown": 0, "description": "A bite that keeps working after you let go.",
          "sound": "audio_licensed/mim_bite.wav",
          "actions": [ { "do": "damage", "type": "Bio", "min": 2, "max": 5, "scale": "Smarts", "scaleMult": 0.3, "perRank": 1 },
                       { "do": "effect", "effect": "#Poisoned", "stacks": 3 } ] },
        { "base": "Bolt", "name": "Drop from Above", "range": 5, "staminaCost": 10, "cooldown": 4, "description": "Come down behind it from the ceiling. Anything caught in your web doesn't see it coming.",
          "sound": "audio_licensed/mim_claw.wav",
          "actions": [ { "do": "warp", "warpTo": "behind" }, { "do": "damage", "type": "Piercing", "min": 4, "max": 7, "scale": "Smarts", "scaleMult": 0.4, "perRank": 1 },
                       { "do": "stun", "turns": 1, "ifTargetHas": "@Webbed" } ] },
        { "base": "Blast", "name": "Silk Snare", "ifSkill": "MOD_Snareseer", "range": 6, "radius": 0, "staminaCost": 10, "cooldown": 5, "description": "A snareseer's silk: a web laid where you know they will step, and whatever trips it is held fast and bitten.", "sound": "audio_licensed/mim_web.wav", "actions": [ { "do": "trap", "fieldName": "Silk Snare", "affects": "enemies", "triggerRadius": 1.5, "radius": 1.5, "charges": 1, "maxTraps": 2, "look": "HAZARD_Holosmoke@0.35", "actions": [ { "do": "effect", "effect": "@Webbed" }, { "do": "effect", "effect": "#Poisoned", "stacks": 2 }, { "do": "damage", "type": "Bio", "min": 2, "max": 4, "scale": "Smarts", "scaleMult": 0.25 } ] } ] },
        { "base": "Buff", "name": "Shed the Shape", "staminaCost": 0, "cooldown": 0, "description": "Let the borrowed body go.",
          "actions": [ { "do": "purge", "to": "self", "effect": "@FormWeaver" } ] }
      ] },
    { "id": "Webbed", "name": "Webbed", "debuff": true, "duration": 2, "root": true, "stats": { "Dodge": -10 },
      "description": "Stuck fast in sticky cable-silk." },

    { "id": "FormWyrm", "name": "Reactor Wyrm", "group": "MimeticForm", "duration": 10, "icon": "mimeticist_t7.png",
      "description": "The thing that nests in the reactor shafts: scaled against the heat, breathing slag and spores, wings that fill a corridor.",
      "damageDealtMult": 1.15, "stats": { "HealthMax": 20, "Armor": 3 }, "resists": { "Fire": 50, "Bio": 25 },
      "kit": [
        { "base": "Bolt", "name": "Slag Breath", "range": 4, "shape": "cone", "angle": 60, "staminaCost": 12, "cooldown": 3,
          "description": "Breathe a cone of molten slag.", "sound": "audio_licensed/mim_breath.wav", "impactVfx": "PA_Elementalist_MagmaBurst.impactParticle@0.4",
          "actions": [ { "do": "damage", "type": "Fire", "min": 4, "max": 8, "scale": "Smarts", "scaleMult": 0.45, "perRank": 2 },
                       { "do": "effect", "effect": "#Burning" } ] },
        { "base": "Blast", "name": "Fallout Spores", "range": 5, "radius": 2, "staminaCost": 12, "cooldown": 6,
          "description": "Cough up a cloud of irradiated spores that hangs over the deck.", "sound": "audio_licensed/mim_breath.wav",
          "actions": [ { "do": "field", "fieldName": "Fallout Spores", "turns": 4, "radius": 2, "affects": "enemies", "look": "HAZARD_Gas@0.6",
                         "actions": [ { "do": "damage", "type": "Bio", "min": 2, "max": 4, "scale": "Smarts", "scaleMult": 0.2 }, { "do": "effect", "effect": "#Poisoned" } ] } ] },
        { "base": "Nova", "name": "Wingbeat", "radius": 2, "staminaCost": 10, "cooldown": 5, "description": "Spread the wings in a corridor and everything near you goes flying.",
          "sound": "sfx/mim_wing.wav",
          "actions": [ { "do": "damage", "type": "Crushing", "min": 2, "max": 5, "scale": "Smarts", "scaleMult": 0.25 }, { "do": "knockback", "amount": 2 } ] },
        { "base": "Bolt", "name": "Firestorm Breath", "ifSkill": "SKILLTREE_Pyromaniac|SKILLTREE_Elementalist", "range": 5, "shape": "cone", "angle": 75, "staminaCost": 14, "cooldown": 5, "description": "Fire you already knew pours out through the wyrm's throat: a wider, hotter cone that sets the deck alight.", "sound": "audio_licensed/mim_breath.wav", "impactVfx": "PA_Elementalist_MagmaBurst.impactParticle@0.4", "actions": [ { "do": "damage", "type": "Fire", "min": 5, "max": 9, "scale": "Smarts", "scaleMult": 0.45, "perRank": 2 }, { "do": "effect", "effect": "#Burning", "stacks": 2 }, { "do": "hazard", "hazard": "HAZARD_Fire_Mini" } ] },
        { "base": "Bolt", "name": "Rime Breath", "ifSkill": "MOD_RimelightSeer|MOD_KelvinMagus", "range": 4, "shape": "cone", "angle": 60, "staminaCost": 12, "cooldown": 4, "description": "Your cold craft turns the wyrm's breath to frost: a cone that bites and slows.", "sound": "audio_licensed/mim_breath.wav", "impactVfx": "PA_Elementalist_FrigidBlast.impactParticle@0.5", "actions": [ { "do": "damage", "type": "Cryo", "min": 4, "max": 8, "scale": "Smarts", "scaleMult": 0.4, "perRank": 2 }, { "do": "effect", "effect": "#Chilled", "stacks": 2 }, { "do": "effect", "effect": "SLOW", "turns": 2 } ] },
        { "base": "Buff", "name": "Shed the Shape", "staminaCost": 0, "cooldown": 0, "description": "Let the borrowed body go.",
          "actions": [ { "do": "purge", "to": "self", "effect": "@FormWyrm" } ] }
      ] }
  ],
  "tiers": [
    {
      "attributes": { "Smarts": 1 },
      "newAbility": {
        "base": "Passive", "name": "Field Sampling", "icon": "mimeticist_t0.png",
        "description": "Anything you kill feeds you, if you're quick about it, and rebuilding your body is hungry work.",
        "procs": [ { "on": "kill", "actions": [ { "do": "stamina", "to": "self", "amount": 4 } ] } ]
      }
    },
    {
      "attributes": { "Toughness": 1 },
      "newAbility": {
        "base": "Bolt", "name": "Sampling Dart", "icon": "mimeticist_t1.png", "staminaCost": 6,
        "description": "A barbed collection dart. It stings, and if the creature dies with it in, you recover more stamina.",
        "sound": "audio_licensed/mim_dart.wav",
        "actions": [ { "do": "damage", "type": "Bio", "min": 2, "max": 5, "scale": "Smarts", "scaleMult": 0.4, "perRank": 1 },
                     { "do": "effect", "effect": "@Tagged" } ],
        "perk": { "name": "Barbed Darts", "description": "The dart tears going in.", "addActions": [ { "do": "effect", "effect": "#Gashed" } ] }
      }
    },
    {
      "attributes": { "Smarts": 1 },
      "newAbility": {
        "base": "Buff", "name": "Become the Panther", "icon": "mimeticist_t2.png", "cooldown": 12, "staminaCost": 20,
        "description": "Rebuild yourself as a vent panther for ten turns: stalk, spring, vanish, and open every wound.",
        "sound": "sfx/mim_shift.wav", "castVfx": "PA_Psykonics_Temporal.castParticle",
        "actions": [ { "do": "effect", "to": "self", "effect": "@FormPanther" } ],
        "perk": { "name": "Quick Change", "cooldownDelta": -4 }
      }
    },
    {
      "attributes": { "Toughness": 1 },
      "newAbility": {
        "base": "Buff", "name": "Become the Hound", "icon": "mimeticist_t3.png", "cooldown": 12, "staminaCost": 20,
        "description": "Rebuild yourself as a scrap hound for ten turns: hamstring, run them down, and call a muttwolf to hunt beside you.",
        "sound": "sfx/mim_shift.wav", "castVfx": "PA_Psykonics_Temporal.castParticle",
        "actions": [ { "do": "effect", "to": "self", "effect": "@FormHound" } ],
        "perk": { "name": "Quick Change", "cooldownDelta": -4 }
      }
    },
    {
      "attributes": { "Smarts": 1 },
      "newAbility": {
        "base": "Buff", "name": "Become the Hullback", "icon": "mimeticist_t4.png", "cooldown": 14, "staminaCost": 20,
        "description": "Rebuild yourself as a plated hullback for ten turns: rush through them, bellow, and shell down while they break on you.",
        "sound": "sfx/mim_shift.wav", "castVfx": "PA_Psykonics_Temporal.castParticle",
        "actions": [ { "do": "effect", "to": "self", "effect": "@FormHullback" } ],
        "perk": { "name": "Quick Change", "cooldownDelta": -4 }
      }
    },
    {
      "attributes": { "Toughness": 1 },
      "newAbility": {
        "base": "Buff", "name": "Become the Lurker", "icon": "mimeticist_t5.png", "cooldown": 12, "staminaCost": 20,
        "description": "Rebuild yourself as a sump lurker for ten turns: snare them with your tongue, roll them under, and poison whatever bites you.",
        "sound": "sfx/mim_shift.wav", "castVfx": "PA_Psykonics_Temporal.castParticle",
        "actions": [ { "do": "effect", "to": "self", "effect": "@FormLurker" } ],
        "perk": { "name": "Quick Change", "cooldownDelta": -4 }
      }
    },
    {
      "attributes": { "Smarts": 1 },
      "newAbility": {
        "base": "Buff", "name": "Become the Weaver", "icon": "mimeticist_t6.png", "cooldown": 14, "staminaCost": 20,
        "description": "Rebuild yourself as a lattice weaver for ten turns: web the deck, poison with your fangs, and drop on them from above.",
        "sound": "sfx/mim_shift.wav", "castVfx": "PA_Psykonics_Temporal.castParticle",
        "actions": [ { "do": "effect", "to": "self", "effect": "@FormWeaver" } ],
        "perk": { "name": "Quick Change", "cooldownDelta": -4 }
      }
    },
    {
      "attributes": { "Smarts": 1, "Toughness": 1 },
      "newAbility": {
        "base": "Buff", "name": "Become the Wyrm", "icon": "mimeticist_t7.png", "cooldown": 20, "staminaCost": 32,
        "description": "Become the reactor wyrm for ten turns: slag breath, spore fallout and wings that clear a corridor.",
        "sound": "sfx/mim_shift.wav", "castVfx": "PA_Prototype_Thunderclap.impactParticle@0.4",
        "actions": [ { "do": "effect", "to": "self", "effect": "@FormWyrm" } ],
        "perk": { "name": "Slow Cooling", "cooldownDelta": -5 }
      }
