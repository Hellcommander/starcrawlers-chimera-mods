        "sound": "sfx/tide_lash.wav",
        "actions": [
          {
            "do": "damage",
            "type": "Crushing",
            "min": 2,
            "max": 5,
            "scale": "Smarts",
            "scaleMult": 0.4,
            "perRank": 1
          },
          {
            "do": "effect",
            "effect": "@Brinecut",
            "stacks": 2
          },
          {
            "do": "effect",
            "effect": "@Soaked"
          },
          {
            "do": "knockback",
            "amount": 1,
            "when": {
              "value": "stacks:@Soaked",
              "of": "target",
              "atLeast": 5
