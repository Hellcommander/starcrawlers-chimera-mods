{
  "id": "MOD_Tidewright",
  "name": "Tidewright",
  "description": "Hydromancers from the reactor decks who drive seawater at crushing pressure. Everything they touch gets Waterlogged, deeper with every hit: slow, clumsy, and easy to shove around.\n\nCut, pin and burst: a jet that slices, a shackle of water that holds them fast, a fog that hides your side, a current to ride, a gyre that drags them together for the rupture, a bound water-body, and a flood to end it. Favors [SMT] and [AGL].",
  "archetype": "Intellect",
  "icon": "tidewright.png",
  "attributePriorities": {
    "Smarts": 4,
    "Agility": 2
  },
  "effects": [
    {
      "id": "Soaked",
      "name": "Waterlogged",
      "description": "Soaked through, and deeper with every layer: slower, clumsier, and wide open to shock and cold. At eight layers they can barely move.",
      "duration": 6,
      "debuff": true,
      "maxStacks": 12,
      "stats": {
        "Dodge": -1,
        "RangedAccuracy": -1
      },
      "resists": {
        "Shock": -3,
        "Cryo": -2
      },
      "thresholds": [
        {
          "at": 8,
          "actions": [
            {
              "do": "effect",
              "effect": "SLOW",
              "turns": 3
            }
          ]
        }
      ],
      "onDeathActions": [
        {
          "do": "stamina",
          "to": "self",
          "amount": 5
        }
      ]
    },
    {
      "id": "Brinecut",
      "name": "Brinecut",
      "description": "Salt-water cuts that won't close. A rupture turns every one of them inside out.",
      "duration": 5,
      "debuff": true,
      "maxStacks": 8,
      "dot": {
        "type": "Piercing",
        "min": 1,
        "max": 1
      },
      "vfx": "EFFECT_Bleed"
    },
    {
      "id": "Fret",
      "name": "Sea Fret",
      "description": "Thick salt fog and a crust of hard brine. Attackers lose you in it, and whoever does land a blow gets a faceful of salt water.",
      "duration": 4,
      "damageTakenMult": 0.85,
      "stats": {
        "Dodge": 20
      },
      "procs": [
        {
          "on": "hurt",
          "actions": [
            {
              "do": "damage",
              "to": "attacker",
              "type": "Crushing",
              "min": 2,
              "max": 4
            },
            {
              "do": "effect",
              "to": "attacker",
              "effect": "@Soaked"
            }
          ]
        },
        {
          "on": "dodge",
          "actions": [
            {
              "do": "effect",
              "to": "attacker",
              "effect": "@Soaked",
              "stacks": 2
            }
          ]
        }
      ]
    },
    {
      "id": "FogCover",
      "name": "Fret-Hidden",
      "description": "Somewhere in the salt fog: hard to pick out, and harder to hit.",
      "duration": 2,
      "stats": {
        "Dodge": 20,
        "Stealth": 10
      }
    },
    {
      "id": "Swollen",
      "name": "Swollen Tide",
      "description": "Fed a second core, the Tidebound has grown into a heaving wall of water.",
      "duration": -1,
      "damageDealtMult": 1.35,
      "stats": {
        "Armor": 3,
        "Toughness": 3
      }
    },
    {
      "id": "Floodwater",
      "name": "Floodwater",
      "debuff": true,
      "duration": 2,
      "stats": {
        "Dodge": -5
      },
      "description": "Wading through the flood: it drags at every step."
    },
    {
      "id": "Shackled",
      "name": "Brine-Shackled",
      "debuff": true,
      "duration": 2,
      "root": true,
      "stats": {
        "RangedAccuracy": -10,
        "Dodge": -5
      },
      "description": "Held fast by a coil of heavy water. It can't move, and the spray in its eyes throws off its aim."
    },
    {
      "id": "Fogbound",
      "name": "Fogbound",
      "debuff": true,
      "duration": 2,
      "stats": {
        "RangedAccuracy": -20,
        "Recognition": -3
      },
      "description": "Lost in the salt fog. It can barely see where to swing or shoot, and anyone hidden in the fog is hard to find."
    }
  ],
  "tiers": [
    {
      "attributes": {
        "Smarts": 1
      },
      "newAbility": {
        "base": "Bolt",
        "name": "Brine Lash",
        "synergyPenalty": { "damage": 2 },
        "icon": "tidewright_t1.png",
        "description": "A thin whip of high-pressure saltwater. It cuts deep, the cuts keep weeping, and anyone soaked five layers deep is knocked back by the jet. While you know it, everything you hit gets a little wetter, and the damp keeps you fresh.",
