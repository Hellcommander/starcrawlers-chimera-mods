<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Class Titler, an optional download. dotnet build -c Release puts the exe in ../../tools/ClassTitler/.
       It uses only what .NET Framework has, so players install nothing. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>ClassTitler</AssemblyName>
    <RootNamespace>ClassTitler</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>..\..\tools\ClassTitler\</OutputPath>
    <FrameworkPathOverride>C:\Program Files (x86)\Reference Assemblies\Microsoft\Framework\.NETFramework\v4.7.2</FrameworkPathOverride>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

  <!-- The title archive codec, the same file the loader compiles, so both read and write titles.bwt alike. -->
  <ItemGroup>
    <Compile Include="..\..\..\..\_modding\ClassLoader\TitleArchive.cs" Link="TitleArchive.cs" />
    <!-- The wordsmith, the same file the loader compiles, so the Titler forges the titles the game shows. -->
    <Compile Include="..\..\..\..\_modding\ClassLoader\Wordsmith.cs" Link="Wordsmith.cs" />
  </ItemGroup>

</Project>
