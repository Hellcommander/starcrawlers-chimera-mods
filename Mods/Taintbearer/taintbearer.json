    {
      "id": "Taint",
      "name": "Taint",
      "debuff": true,
      "description": "Corruption in the flesh and the mind. Each layer saps Toughness and Psi Power and lets every blow in a little deeper. When its host dies, the rot moves on to the nearest one.",
      "duration": 5,
      "maxStacks": 6,
      "stats": {
        "Toughness": -1,
        "PsiPower": -1
      },
      "damageTakenPerStack": 0.03,
      "onDeathActions": [
        {
          "do": "chain",
          "jumps": 1,
          "radius": 3,
          "vfx": "TbRotBurst@0.6",
          "actions": [
            {
              "do": "effect",
              "effect": "@Taint",
              "stacks": 2
            }
          ],
          "sound": "audio_licensed/tb_taint_spread.wav"
        }
      ],
      "icon": "icons/taint.png",
      "aura": "TbRotDraw"
    },
    {
      "id": "GatheringRot",
      "name": "Gathering Rot",
      "description": "Every thread of rot in the target is being drawn to one point. It breaks open at the start of your next turn, unless you are stunned first or the target is gone.",
      "duration": 2,
      "vfx": "PA_Cursed_Avatar.PS_cast@0.3",
      "icon": "icons/gathering_rot.png"
    }
  ],
