      "icon": "toxic_breath.png",
      "grants": [
        {
          "base": "Bolt",
          "name": "Toxic Breath",
          "icon": "toxic_breath.png",
          "range": 4,
          "shape": "cone",
          "angle": 70,
          "staminaCost": 12,
          "cooldown": 5,
          "description": "Heave up a gutful of mutated brew in a wide cone. It poisons deep and leaves the air thick and choking. The more of a mutant you are, the worse it gets: it hits harder with every Chaotic Mutant rank, rots their strength at rank 3, and at rank 5 can drop them retching.",
          "sound": "sfx/toxic_breath.wav",
          "impactVfx": "PA_Engineer_Spidermine.PS_explode_bio@0.35",
          "actions": [
            {
              "do": "damage",
              "type": "Bio",
              "min": 4,
              "max": 8,
              "scale": "Smarts+PsiPower",
              "scaleMult": 0.3,
              "perRank": 3
            },
            {
              "do": "effect",
              "effect": "#Poisoned",
              "stacks": 3
            },
            {
              "do": "effect",
              "effect": "MOD_Miasmancer@Choking"
            },
            {
              "do": "effect",
              "effect": "#Poisoned",
              "stacks": 2,
              "when": {
                "value": "rank:SKILLTREE_ChaoticMutant",
                "atLeast": 3
              }
            },
            {
              "do": "effect",
              "effect": "#Weakened",
              "when": {
                "value": "rank:SKILLTREE_ChaoticMutant",
                "atLeast": 3
              }
            },
            {
              "do": "stun",
              "turns": 1,
              "chance": 40,
              "when": {
                "value": "rank:SKILLTREE_ChaoticMutant",
                "atLeast": 5
              }
            }
          ],
          "attachTo": "Breath of the Station"
        }
      ]
    },
