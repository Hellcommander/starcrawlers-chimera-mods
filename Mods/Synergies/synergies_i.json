    },
    {
      "id": "DownTheHole",
      "name": "Down the Hole",
      "trees": [
        "MOD_LookingGlassRogue",
        "SKILLTREE_Acrobatics"
      ],
      "description": "A tumbler knows how to fall: while Shrunk, dodges may leave you Hasted, and while Grown, hits may knock the target a tile back. Each level adds 5% to these odds.",
      "bonus": {
        "procChancePerStack": 5,
        "procs": [
          {
            "on": "dodge",
            "chance": 30,
            "vfx": "LgSizePuff@0.5",
            "actions": [
              {
                "do": "effect",
                "to": "self",
                "effect": "#Hasted",
                "ifSelfHas": "MOD_LookingGlassRogue@Shrunk"
              }
            ]
          },
          {
            "on": "hit",
            "chance": 20,
            "actions": [
              {
                "do": "knockback",
                "amount": 1,
                "when": {
                  "has": "MOD_LookingGlassRogue@Grown",
                  "of": "self"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "WaywardThoughts",
      "name": "Wayward Thoughts",
      "trees": [
        "MOD_LookingGlassRogue",
        "SKILLTREE_Psykonics"
      ],
      "description": "A mind that's lost its bearings is easy to get into: hits on Topsy-Turvy enemies may scramble them, Silenced for two turns. Each level adds 5% to these odds.",
      "bonus": {
        "procChancePerStack": 5,
        "procs": [
          {
            "on": "hit",
            "chance": 35,
            "actions": [
              {
                "do": "silence",
                "turns": 2,
                "ifTargetHas": "MOD_LookingGlassRogue@TopsyTurvy"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "WrongSideOfTheGlass",
      "name": "Wrong Side of the Glass",
      "trees": [
        "MOD_LookingGlassRogue",
        "MOD_PhaseDrifter"
      ],
      "description": "You've both slipped out of true: hits while Phased may leave the target Topsy-Turvy, and dodges while Grinning may slip you Phased. Each level adds 5% to these odds.",
