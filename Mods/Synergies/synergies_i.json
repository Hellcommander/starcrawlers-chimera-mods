{
  "synergies": [
    {
      "id": "ThermalShock",
      "name": "Thermal Shock",
      "trees": [
        "MOD_KelvinMagus",
        "SKILLTREE_Pyromaniac"
      ],
      "description": "Hot and cold, back and forth: hits on Burning enemies may supercool them, and hits on Frozen Solid ones may set them on Fire. Each level adds 5% to these odds.",
      "bonus": {
        "procChancePerStack": 5,
        "procs": [
          {
            "on": "hit",
            "chance": 30,
            "vfx": "KmFrostHit@0.4",
            "actions": [
              {
                "do": "effect",
                "effect": "MOD_KelvinMagus@Supercooled",
                "ifTargetHas": "EFFECT_Fire"
              }
            ]
          },
          {
            "on": "hit",
            "chance": 30,
            "vfx": "EFFECT_Fire@0.4",
            "actions": [
              {
                "do": "effect",
                "effect": "EFFECT_Fire",
                "turns": 3,
                "ifTargetHas": "MOD_KelvinMagus@FrozenSolid"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "AbsoluteZero",
      "name": "Absolute Zero",
      "trees": [
        "MOD_KelvinMagus",
        "SKILLTREE_Elementalist"
      ],
      "description": "Two schools of cold, one result: hits on Chilled enemies may supercool them, and hits on Supercooled ones may chill them. Each level adds 5% to these odds.",
      "bonus": {
        "procChancePerStack": 5,
        "procs": [
          {
            "on": "hit",
            "chance": 30,
            "vfx": "KmFrostHit@0.4",
            "actions": [
              {
                "do": "effect",
                "effect": "MOD_KelvinMagus@Supercooled",
                "ifTargetHas": "EFFECT_Chill"
              }
            ]
          },
          {
            "on": "hit",
            "chance": 30,
            "vfx": "PA_Elementalist_FrigidBlast.impactParticle@0.4",
            "actions": [
              {
                "do": "effect",
                "effect": "EFFECT_Chill",
                "ifTargetHas": "MOD_KelvinMagus@Supercooled"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "FlashFreeze",
      "name": "Flash Freeze",
      "trees": [
        "MOD_KelvinMagus",
        "MOD_Tidewright"
      ],
      "description": "Water gives up its heat fastest: hits on Waterlogged enemies may supercool them twice over, and kills on frozen ones may supercool the foes around them. Each level adds 5% to these odds.",
      "bonus": {
        "procChancePerStack": 5,
        "procs": [
          {
            "on": "hit",
            "chance": 30,
            "vfx": "KmFrostHit@0.4",
            "actions": [
              {
                "do": "effect",
                "effect": "MOD_KelvinMagus@Supercooled",
                "stacks": 2,
                "ifTargetHas": "MOD_Tidewright@Soaked"
              }
            ]
          },
          {
            "on": "kill",
            "chance": 50,
            "radius": 2,
            "when": {
              "has": "MOD_KelvinMagus@FrozenSolid",
              "of": "victim"
            },
            "actions": [
              {
                "do": "effect",
                "effect": "MOD_KelvinMagus@Supercooled"
              }
            ]
          }
        ]
      }
    },
    {
