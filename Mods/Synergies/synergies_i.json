    },
    {
      "id": "ImprobableTea",
      "name": "Improbable Tea",
      "trees": [
        "MOD_LookingGlassRogue",
        "MOD_ProbabilityShaman"
      ],
      "description": "Nobody can agree whether you're there or how big you are: dodges while Unobserved may build Wonder, and hits with four or more Wonder may bank Possibility. Each level adds 5% to these odds.",
      "bonus": {
        "procChancePerStack": 5,
        "procs": [
          {
            "on": "dodge",
            "chance": 40,
            "vfx": "LgWhimsy@0.4",
            "actions": [
              {
                "do": "effect",
                "to": "self",
                "effect": "MOD_LookingGlassRogue@Wonder",
                "ifSelfHas": "MOD_ProbabilityShaman@Unobserved"
              }
            ]
          },
          {
            "on": "hit",
            "chance": 25,
            "when": {
              "value": "stacks:MOD_LookingGlassRogue@Wonder",
              "of": "self",
              "atLeast": 4
            },
            "actions": [
              {
                "do": "effect",
                "to": "self",
                "effect": "MOD_ProbabilityShaman@Possibility"
              }
            ]
          }
        ]
      }
    },
    {
