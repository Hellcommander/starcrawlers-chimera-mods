{
  "synergies": [
    {
      "id": "KindredCurrent",
      "name": "Kindred Current",
      "trees": [
        "MOD_ArcGunner",
        "SKILLTREE_Elementalist"
      ],
      "description": "Electrified enemies count as Shocked for your arc work, and your hits on them may arc that on to the next foe in reach. Each level adds 5% to these odds.",
      "bonus": {
        "procChancePerStack": 5,
        "procs": [
          {
            "on": "hit",
            "chance": 35,
            "vfx": "PA_Elementalist_ChainLightning.shockImpact@0.5",
            "actions": [
              {
                "do": "effect",
                "effect": "#Shocked",
                "ifTargetHas": "EFFECT_Shock"
              }
            ]
          },
          {
            "on": "hit",
            "chance": 25,
            "maxPerTurn": 1,
            "when": {
              "has": "EFFECT_Shock"
            },
            "actions": [
              {
                "do": "chain",
                "jumps": 1,
                "radius": 3,
                "actions": [
                  {
                    "do": "effect",
                    "effect": "#Shocked",
                    "stacks": 1
                  }
                ]
              }
            ]
          }
        ]
      }
    },
