{
  "id": "MOD_LookingGlassRogue",
  "name": "Looking-Glass Rogue",
  "description": "Duelists who went down the wrong maintenance shaft, came back the wrong size, and never quite came back right. Nothing they do happens the same way twice.\n\nDrink Me, Eat Me swaps you between Shrunk (very hard to hit) and Grown (heavy blows that send enemies flying), and most of the kit changes with it. Dodges and kills build Wonder, which tilts every random outcome your way. A Tea Clock ticks through each fight and pours at six. Painted Guards daub enemies red for the claws and teeth of the last two ranks, where you learn to vanish and leave your grin behind, and then to become the Grinning Cat. Favors [AGL] and [PSI].\n\nExample mod: almost every skill runs on conditions, counters and the extra triggers (see LookingGlass/README.md).",
  "archetype": "Guile",
  "icon": "icons/looking_glass_rogue.png",
  "iconFrom": "SKILLTREE_Acrobatics",
  "attributePriorities": { "Agility": 4, "PsiPower": 4, "Recognition": 1 },
  "conditions": {
    "Small": { "has": "@Shrunk", "of": "self" },
    "Big": { "has": "@Grown", "of": "self" },
    "Curious": { "value": "stacks:@Wonder", "of": "self", "atLeast": 4 },
    "WellMarked": { "value": "stacks:@PaintedRed", "of": "target", "atLeast": 3 },
    "Reeling": { "any": [ { "has": "@TopsyTurvy", "of": "target" }, { "has": "SCCLFX_SCCLCore_Silenced", "of": "target" } ] },
    "GuardsUp": { "value": "summons:PaintedGuard", "of": "self", "atLeast": 1 },
    "Puzzled": { "value": "counter:Riddles", "of": "self", "atLeast": 3 }
  },
  "effects": [
    { "id": "Wonder", "name": "Wonder", "icon": "icons/wonder.png", "resource": true, "resourceColor": "#FF70D8",
      "description": "Things keep getting curiouser. Every stack sharpens your crits and dodges, and tilts your random outcomes toward the good ones. It fades if nothing strange happens for a while.",
      "duration": 6, "maxStacks": 8, "stats": { "Crit": 2, "Dodge": 1 } },
    { "id": "TeaClock", "name": "Tea Clock", "icon": "icons/tea_clock.png", "resource": true, "resourceColor": "#5CE1C8",
      "description": "The hours of the fight. Each turn in combat moves it on, and growing or waiting beside an enemy (once you know the Mad Tea Party) moves it faster. At six o'clock it's always tea time: you catch your breath and something whimsical happens.",
      "duration": -1, "maxStacks": 6, "burstAt": 6, "burstVfx": "LgWhimsy", "burstSound": "audio_licensed/lg_teaparty.wav",
      "burstActions": [
        { "do": "stamina", "to": "self", "amount": 15 },
        { "do": "effect", "to": "self", "effect": "@Wonder", "stacks": 2 },
        { "do": "random", "to": "self", "stacksOf": "@Wonder", "stacksFrom": "self", "options": [
          { "name": "Tea time: a fresh cup", "weight": 2, "actions": [ { "do": "heal", "to": "self", "amount": 6, "perRank": 1 } ] },
          { "name": "Tea time: move down!", "weight": 2, "weightPerStack": 1, "actions": [ { "do": "cooldowns", "to": "self", "amount": 2 } ] },
          { "name": "Tea time: no room!", "weight": 1, "weightPerStack": 1, "actions": [ { "do": "effect", "to": "self", "effect": "@Grinning" } ] } ] } ] },
    { "id": "Shrunk", "name": "Shrunk", "icon": "icons/shrunk.png", "group": "Size",
      "description": "A few inches tall. Very hard to hit, but your blows land softer. Much of your kit works differently while you're small.",
      "duration": -1, "damageDealtMult": 0.8, "stats": { "Dodge": 25, "Agility": 2 } },
    { "id": "Grown", "name": "Grown", "icon": "icons/grown.png", "group": "Size",
      "description": "Head scraping the ceiling. You hit much harder and shrug off more, but you're an easy target. Much of your kit works differently while you're big.",
      "duration": -1, "damageDealtMult": 1.3, "stats": { "Strength": 3, "Toughness": 3, "Dodge": -15 } },
    { "id": "PaintedRed", "name": "Painted Red", "icon": "icons/painted_red.png", "debuff": true,
      "description": "Daubed in red paint. Easier to find, and the Grinning Cat's teeth tear every layer off at once.",
      "duration": 8, "maxStacks": 5, "stats": { "Dodge": -2 } },
    { "id": "TopsyTurvy", "name": "Topsy-Turvy", "icon": "icons/topsy_turvy.png", "debuff": true,
      "description": "Up is down and left is a rumour. It hits softer and can't get out of the way.",
      "duration": 2, "damageDealtMult": 0.8, "stats": { "Dodge": -10, "RangedAccuracy": -10 } },
    { "id": "Grinning", "name": "Grinning", "icon": "icons/grinning.png",
      "description": "Mostly gone. Only the grin is still there, and it's very hard to hit a grin.",
      "duration": 2, "stats": { "Dodge": 40, "Crit": 25 } },
    { "id": "CardSoldier", "name": "Card Soldier", "icon": "icons/painted_guard.png",
      "description": "A painted guard from a deck that wandered off. Lacquered stiff, nimble for a card, it shrugs off a good share of every blow and patches itself up a little each turn, and every blow it lands paints its target red.",
      "duration": -1, "stats": { "Dodge": 10, "Toughness": 4 }, "damageTakenMult": 0.7, "hot": 2,
      "procs": [ { "on": "hit", "actions": [ { "do": "effect", "effect": "@PaintedRed" } ] } ] },
    { "id": "LingeringGrin", "name": "Lingering Grin", "icon": "icons/lingering_grin.png",
      "description": "A grin with nobody behind it. Enemies can't stop looking at it, anyone who strikes it is left topsy-turvy, and when it fades it snaps its teeth on the nearest of them.",
      "duration": -1, "stats": { "Dodge": 35 },
      "procs": [ { "on": "hurt", "actions": [ { "do": "effect", "to": "attacker", "effect": "@TopsyTurvy" } ] } ],
      "onDeathActions": [
        { "do": "chain", "jumps": 2, "radius": 3, "vfx": "LgBite@0.6",
          "actions": [ { "do": "damage", "type": "Piercing", "min": 5, "max": 9, "scale": "Agility+PsiPower", "scaleMult": 0.2 },
                       { "do": "effect", "effect": "@PaintedRed" } ] } ] },
    { "id": "GrinningCat", "name": "The Grinning Cat", "icon": "icons/grinning_cat.png",
      "description": "You are a gaunt striped cat that comes and goes as it pleases, tail first and grin last, and the grin is always a little too wide. Very hard to pin down, every dodge rakes the one who swung, and a killing blow finds no body to land on (once). You fight with the cat's teeth and warps until it fades or you Reappear.",
      "duration": 8, "damageDealtMult": 1.2, "stats": { "Dodge": 30, "Agility": 4, "PsiPower": 3, "Crit": 15 },
      "preventDeath": 1,
      "onSaveActions": [
        { "do": "heal", "to": "self", "amount": 10, "perRank": 2 },
        { "do": "effect", "to": "self", "effect": "@Grinning" },
        { "do": "purge", "to": "self", "effect": "@GrinningCat" } ],
      "procs": [
        { "on": "dodge", "actions": [ { "do": "damage", "to": "attacker", "type": "Slashing", "min": 2, "max": 4, "scale": "Agility+PsiPower", "scaleMult": 0.15 },
                                     { "do": "effect", "to": "attacker", "effect": "@TopsyTurvy" } ] },
        { "on": "hit", "when": { "lacks": "@PaintedRed", "of": "victim" }, "actions": [ { "do": "effect", "effect": "@PaintedRed" } ] },
        { "on": "kill", "actions": [ { "do": "effect", "to": "self", "effect": "@Grinning" }, { "do": "effect", "to": "self", "effect": "@Wonder" } ] } ],
      "keep": [ "Grin Without a Cat" ],
      "kit": [
        { "name": "Grin of Teeth", "icon": "icons/grin_of_teeth.png", "target": "enemy", "range": 4, "staminaCost": 8, "cooldown": 1,
          "description": "A grin far too big for any face opens around them and snaps shut. It tears off every layer of Painted Red for more, bites deeper into anyone turned around, and leaves them bleeding.",
          "impactVfx": "LgBite", "sound": "audio_licensed/lg_bite.wav",
          "actions": [
            { "do": "show", "model": { "mesh": "models/grin.glb", "scale": 1.9, "offset": [0, 0.55, 0], "glow": "#ff70d8", "glowStrength": 0.9 },
              "showStyle": "snap", "showTime": 0.9 },
            { "do": "damage", "type": "Piercing", "min": 7, "max": 12, "scale": "Agility+PsiPower", "scaleMult": 0.3, "perRank": 2,
              "bonusPerStack": 4, "stacksOf": "@PaintedRed", "stacksFrom": "target", "consumeStacks": true },
            { "do": "damage", "type": "Piercing", "min": 3, "max": 6, "perRank": 1, "when": "Reeling" },
            { "do": "effect", "effect": "#Gashed" } ] },
        { "name": "Warp Pounce", "icon": "icons/warp_pounce.png", "target": "enemy", "range": 7, "staminaCost": 6, "cooldown": 2,
          "description": "Fold the room and come out of it behind them, claws first. Leaves them topsy-turvy and builds Wonder.",
          "castVfx": "LgWarp", "impactVfx": "LgClaw", "sound": "audio_licensed/lg_warp.wav",
          "actions": [
            { "do": "warp", "warpTo": "behind", "vfx": "LgWarp" },
            { "do": "damage", "type": "Slashing", "min": 4, "max": 7, "scale": "Agility+PsiPower", "scaleMult": 0.22, "perRank": 1 },
            { "do": "effect", "effect": "@TopsyTurvy" },
            { "do": "effect", "to": "self", "effect": "@Wonder" } ] },
        { "name": "Which Way?", "icon": "icons/which_way.png", "target": "enemy", "range": 8, "staminaCost": 6, "cooldown": 3,
          "targetWhen": { "not": { "tag": "boss" } },
          "description": "Ask them which way they ought to go, then answer for them: you and they warp into each other's places, and they're left topsy-turvy (not bosses). Leaves you Grinning.",
          "castVfx": "LgWarp", "impactVfx": "LgWarp@0.7", "sound": "audio_licensed/lg_warp.wav",
          "actions": [ { "do": "swap" }, { "do": "effect", "effect": "@TopsyTurvy" }, { "do": "effect", "to": "self", "effect": "@Grinning" } ] },
        { "name": "All Mad Here", "icon": "icons/all_mad_here.png", "target": "self", "radius": 3, "cooldown": 4, "staminaCost": 10,
          "description": "Point out to everyone nearby that they must be mad, or they wouldn't have come here. A psychic jolt that grows with every riddle asked this fight; they lose their bearings and their big moves wait, and with four Wonder or more they lose their words too and the room rearranges itself around them (each may warp up to two tiles). Each one counts as a riddle.",
          "castVfx": "LgWhimsy", "impactVfx": "LgWhimsy@0.5", "sound": "audio_licensed/lg_mad_here.wav",
          "actions": [
            { "do": "damage", "type": "Psi", "min": 3, "max": 6, "scale": "PsiPower", "scaleMult": 0.3, "perRank": 1,
              "bonusPerStack": 2, "stacksOf": "counter:Riddles", "stacksFrom": "self" },
            { "do": "effect", "effect": "@TopsyTurvy" },
            { "do": "exhaust", "amount": 1 },
            { "do": "silence", "turns": 1, "when": "Curious" },
            { "do": "warp", "warpTo": "random", "amount": 2, "chance": 50, "when": "Curious", "vfx": "LgWarp@0.6" },
            { "do": "counter", "to": "self", "counter": "Riddles", "amount": 1, "counterMax": 6 } ] },
        { "name": "Reappear", "icon": "icons/reappear.png", "target": "self", "instant": true, "staminaCost": 0,
          "description": "Come all the way back, grin first this time, with your breath and a little Wonder.",
          "sound": "audio_licensed/lg_shrink.wav",
          "actions": [ { "do": "purge", "effect": "@GrinningCat" }, { "do": "stamina", "amount": 12 }, { "do": "effect", "effect": "@Wonder", "stacks": 2 } ] } ] }
  ],
  "tiers": [
    { "attributes": { "Agility": 1 },
      "newAbility": {
        "base": "Passive", "name": "Curiouser", "icon": "icons/curiouser.png",
        "description": "Dodging builds Wonder and so does a kill. Every fight starts the Tea Clock at noon and every turn in it moves the clock on. Each third skill you use sets off a little whimsy of its own. Shrinking builds Wonder and growing moves the clock (once a turn each).",
        "procs": [
          { "on": "combatStart", "actions": [
            { "do": "purge", "to": "self", "effect": "@TeaClock" },
            { "do": "counter", "to": "self", "counter": "Riddles", "amount": 0, "counterSet": true },
            { "do": "effect", "to": "self", "effect": "@Wonder" } ] },
          { "on": "turn", "when": { "inCombat": true }, "actions": [ { "do": "effect", "to": "self", "effect": "@TeaClock" } ] },
          { "on": "dodge", "actions": [ { "do": "effect", "to": "self", "effect": "@Wonder" } ] },
          { "on": "kill", "actions": [ { "do": "effect", "to": "self", "effect": "@Wonder", "stacks": 2 } ] },
          { "on": "cast", "every": 3, "vfx": "LgWhimsy", "sound": "audio_licensed/lg_watch.wav",
            "actions": [ { "do": "random", "stacksOf": "@Wonder", "stacksFrom": "self", "to": "self", "options": [
              { "name": "Late, late!", "weight": 2, "weightPerStack": 1,
                "actions": [ { "do": "cooldowns", "amount": 1 }, { "do": "effect", "to": "self", "effect": "#Hasted" } ] },
              { "name": "An unbirthday present", "weight": 2, "weightPerStack": 1,
                "actions": [ { "do": "stamina", "to": "self", "amount": 12 } ] },
              { "name": "Curiouser and curiouser", "weight": 2,
                "actions": [ { "do": "effect", "to": "self", "effect": "@Wonder", "stacks": 2 } ] },
              { "name": "A size slip", "weight": 2,
                "actions": [ { "do": "if", "when": "Small",
                  "then": [ { "do": "effect", "to": "self", "effect": "@Grown" } ],
                  "else": [ { "do": "effect", "to": "self", "effect": "@Shrunk" } ] } ] },
              { "name": "Only the grin", "weight": 1, "weightPerStack": 1,
                "actions": [ { "do": "effect", "to": "self", "effect": "@Grinning" } ] } ] } ] },
          { "on": "effectGained", "match": "@Shrunk", "maxPerTurn": 1, "vfx": "LgSizePuff",
            "actions": [ { "do": "effect", "to": "self", "effect": "@Wonder" } ] },
          { "on": "effectGained", "match": "@Grown", "maxPerTurn": 1, "vfx": "LgSizePuff",
            "actions": [ { "do": "effect", "to": "self", "effect": "@TeaClock" } ] } ] } },

    { "attributes": { "Agility": 1 },
      "newAbility": {
        "base": "Strike", "name": "Snicker-Snack", "icon": "icons/snicker_snack.png", "staminaCost": 6, "cooldown": 0,
        "description": "A blade that never cuts the same number of times twice; Wonder makes the longer flurries likelier. Grown, it hits harder. Shrunk, every flurry builds Wonder. Against anything under a third of its health one more cut goes in.",
        "impactVfx": "LgSlash", "sound": "audio_licensed/lg_flurry.wav",
        "actions": [
          { "do": "random", "stacksOf": "@Wonder", "stacksFrom": "self", "options": [
            { "name": "Snick", "weight": 3,
              "actions": [ { "do": "damage", "type": "Slashing", "min": 3, "max": 6, "scale": "Agility+PsiPower", "scaleMult": 0.2, "perRank": 1 } ] },
            { "name": "Snicker-snack", "weight": 2, "weightPerStack": 1,
              "actions": [ { "do": "damage", "type": "Slashing", "min": 2, "max": 5, "scale": "Agility+PsiPower", "scaleMult": 0.17, "perRank": 1 },
                           { "do": "damage", "type": "Slashing", "min": 2, "max": 5, "scale": "Agility+PsiPower", "scaleMult": 0.17, "perRank": 1 } ] },
            { "name": "Vorpal rush", "weight": 1, "weightPerStack": 1,
              "actions": [ { "do": "damage", "type": "Slashing", "min": 2, "max": 4, "scale": "Agility+PsiPower", "scaleMult": 0.15, "perRank": 1 },
                           { "do": "damage", "type": "Slashing", "min": 2, "max": 4, "scale": "Agility+PsiPower", "scaleMult": 0.15, "perRank": 1 },
                           { "do": "damage", "type": "Slashing", "min": 2, "max": 4, "scale": "Agility+PsiPower", "scaleMult": 0.15, "perRank": 1 } ] } ] },
          { "do": "damage", "type": "Crushing", "min": 2, "max": 4, "perRank": 1, "when": "Big" },
          { "do": "effect", "to": "self", "effect": "@Wonder", "when": "Small" },
          { "do": "damage", "type": "Slashing", "min": 3, "max": 6, "perRank": 1, "when": { "value": "health%", "of": "target", "below": 33 } } ],
        "perk": { "name": "Vorpal Edge", "damageMult": 1.25 } } },

    { "attributes": { "PsiPower": 1 },
      "newAbility": {
        "base": "Buff", "name": "Drink Me, Eat Me", "icon": "icons/drink_me.png", "staminaCost": 4, "cooldown": 2,
        "description": "A sip to shrink, a bite to grow. Switches you between Shrunk and Grown (from normal size, you shrink first) and builds Wonder. With four Wonder or more the label lies in your favour and you get a burst of speed too.",
        "castVfx": "LgSizePuff", "sound": "audio_licensed/lg_shrink.wav",
        "actions": [
          { "do": "if", "when": "Small",
            "then": [ { "do": "effect", "to": "self", "effect": "@Grown" } ],
            "else": [ { "do": "effect", "to": "self", "effect": "@Shrunk" } ] },
          { "do": "effect", "to": "self", "effect": "#Hasted", "when": "Curious" },
          { "do": "effect", "to": "self", "effect": "@Wonder" } ],
        "perk": { "name": "Mushroom Nibble", "cooldownDelta": -1 } } },

    { "attributes": { "PsiPower": 1, "Recognition": 1 },
      "newAbility": {
        "name": "Painted Guard", "icon": "icons/painted_guard.png", "target": "self", "staminaCost": 10, "cooldown": 8,
        "description": "Deal a playing-card soldier out of thin air. It fights at your side, and every hit it lands paints its target red. Up to two at once. When the last one is torn up, you get two Wonder out of it.",
        "castVfx": "LgCardBurst", "sound": "audio_licensed/lg_guard.wav",
        "actions": [
          { "do": "summon", "creature": "PaintedGuard", "summonGroup": "PaintedGuard", "summonVfx": "LgCardBurst",
            "maxSummons": 2, "turns": 18, "effect": "@CardSoldier" },
          { "do": "effect", "to": "self", "effect": "@Wonder" } ],
        "procs": [ { "on": "allyDeath", "when": { "not": "GuardsUp" },
                     "actions": [ { "do": "effect", "to": "self", "effect": "@Wonder", "stacks": 2 } ] } ],
        "perk": { "name": "Full Suit", "cooldownDelta": -3 } } },

    { "attributes": { "Agility": 1, "PsiPower": 1 },
      "newAbility": {
        "base": "Smash", "name": "Hedgehog Croquet", "icon": "icons/hedgehog_croquet.png", "staminaCost": 8, "cooldown": 3,
        "targetWhen": { "not": { "tag": "boss" } },
        "description": "Treat them like the ball (not bosses). Grown, you knock them three tiles and anyone they hit takes it too. Shrunk, you dart between their legs, swap places and leave them topsy-turvy. Otherwise, a solid tap one tile back. While you know it and are Grown, half your crits knock their target a tile away.",
        "impactVfx": "LgCroquet", "sound": "sfx/lg_croquet.wav",
        "actions": [
          { "do": "damage", "type": "Crushing", "min": 3, "max": 6, "scale": "Agility+PsiPower", "scaleMult": 0.2, "perRank": 1 },
          { "do": "if", "when": "Big",
            "then": [ { "do": "throw", "amount": 3, "actions": [
                        { "do": "damage", "type": "Crushing", "min": 4, "max": 7, "perRank": 1 },
                        { "do": "effect", "effect": "@TopsyTurvy" } ] } ],
            "else": [ { "do": "if", "when": "Small",
              "then": [ { "do": "swap" }, { "do": "effect", "effect": "@TopsyTurvy" }, { "do": "effect", "to": "self", "effect": "@Wonder" } ],
              "else": [ { "do": "throw", "amount": 1, "actions": [ { "do": "damage", "type": "Crushing", "min": 2, "max": 4 } ] } ] } ] } ],
        "procs": [ { "on": "crit", "when": { "all": [ "Big", { "chance": 50 } ] }, "maxPerTurn": 1,
                     "actions": [ { "do": "knockback", "amount": 1 } ] } ],
        "perk": { "name": "Flamingo Grip", "damageMult": 1.25 } } },

    { "attributes": { "Agility": 1, "Recognition": 1 },
      "newAbility": {
        "name": "Mad Tea Party", "icon": "icons/mad_tea_party.png", "target": "floor", "range": 5, "radius": 1.5,
        "staminaCost": 10, "cooldown": 8,
        "description": "Lay a tea table nobody asked for. Every turn, each enemy at it gets something different: warped to another seat, told there's no room, asked a riddle with no answer, served scalding tea, or wished a happy unbirthday. Riddles asked this fight feed All Mad Here. While you know it, waiting with an enemy close moves the Tea Clock on an extra hour.",
        "areaVfx": "LgWhimsy", "sound": "audio_licensed/lg_teaparty.wav",
        "actions": [
          { "do": "field", "fieldName": "Mad Tea Party", "turns": 4, "radius": 1.5, "affects": "enemies", "spacing": 1.4,
            "model": { "mesh": "models/teapot.glb", "scale": 0.5, "offset": [0, 0.2, 0], "wobble": 10, "randomYaw": true },
            "pulseVfx": "LgTeaSteam",
            "actions": [ { "do": "random", "options": [
              { "name": "Change places!", "weight": 2,
                "actions": [ { "do": "warp", "warpTo": "random", "amount": 2, "vfx": "LgWarp@0.6" }, { "do": "effect", "effect": "@TopsyTurvy" } ] },
              { "name": "No room!", "weight": 2,
                "actions": [ { "do": "throw", "amount": 2, "actions": [ { "do": "damage", "type": "Crushing", "min": 2, "max": 4, "perRank": 1 } ] } ] },
              { "name": "A riddle with no answer", "weight": 2,
                "actions": [ { "do": "silence", "turns": 1 }, { "do": "exhaust", "amount": 1 },
                             { "do": "counter", "to": "self", "counter": "Riddles", "amount": 1, "counterMax": 6 } ] },
              { "name": "Scalding tea", "weight": 2,
                "actions": [ { "do": "damage", "type": "Fire", "min": 2, "max": 5, "scale": "PsiPower", "scaleMult": 0.15, "perRank": 1 } ] },
              { "name": "Happy unbirthday", "weight": 1,
                "actions": [ { "do": "effect", "effect": "@PaintedRed", "stacks": 2 } ] } ] } ] },
          { "do": "effect", "to": "self", "effect": "@Wonder" } ],
        "procs": [ { "on": "wait", "when": { "value": "enemiesNear:3", "of": "self", "atLeast": 1 },
                     "actions": [ { "do": "effect", "to": "self", "effect": "@TeaClock" } ] } ],
        "perk": { "name": "Endless Teatime", "cooldownDelta": -2 } } },

    { "attributes": { "Agility": 1, "PsiPower": 1 },
      "newAbility": {
        "base": "Blink", "name": "Vanishing Grin", "icon": "icons/vanishing_grin.png", "range": 5, "staminaCost": 8, "cooldown": 6,
        "description": "Fade out from the tail up and reappear somewhere else in the room, still grinning: very hard to hit, and your next blows find the soft spots. Builds two Wonder. While you know it, dropping below a third of your health with two enemies on you shrinks you and leaves only the grin (once every twelve turns), and every second step you take while small builds Wonder.",
        "castVfx": "LgGrin", "sound": "audio_licensed/lg_grin.wav",
        "actions": [
          { "do": "teleport" },
          { "do": "effect", "to": "self", "effect": "@Grinning" },
          { "do": "effect", "to": "self", "effect": "@Wonder", "stacks": 2 } ],
        "procs": [
          { "on": "lowHealth", "threshold": 33, "cooldown": 12, "when": { "value": "enemiesNear:1.5", "of": "self", "atLeast": 2 }, "vfx": "LgGrin",
