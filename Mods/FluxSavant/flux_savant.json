      "newAbility": {
        "base": "Buff",
        "name": "Bench Instincts",
        "icon": "icons/bench_instincts.png",
        "description": "Step back to the bench and work on your rig: opens the rune matrix, where you can charge spent runes with stamina or discharge full ones to deactivate them, even mid-fight. A discharge pays its stamina back once every 8 turns. You never quite stop experimenting, either: your hits sometimes leave a film of aether residue, and kills and the reactions you set off give you stamina back.",
        "procs": [
          {
            "on": "hit",
            "chance": 25,
            "actions": [
              {
                "do": "effect",
                "effect": "@Residue"
              }
            ]
          },
          {
            "on": "kill",
            "actions": [
