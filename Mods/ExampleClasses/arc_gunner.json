{
  "id": "MOD_ArcGunner",
  "name": "Arc Gunner",
  "title": { "adjectives": ["Arc-Charged", "Live-Wired"], "nouns": ["Arc Gunner", "Sparkshooter"], "of": ["the Capacitor", "Static"], "master": "Arcmaster", "themes": ["gun", "storm"], "traits": ["Live-Wired", "-charged"], "roots": ["Arc", "Spark"], "heads": ["Gunner", "-slinger"] },
  "description": "Pistols in one hand, lightning in the other. Gun hits charge a static capacitor; Shocked enemies conduct forked discharges between each other, and Thunder Slug dumps the whole capacitor into one target. Every jump of your lightning charges the grip, and Live Wire turns each shot into another jump.\n\nExample class: built on the shared library (#Shocked, 'Shot' and 'Bolt' templates). Favors [SMT] and [REC].",
  "archetype": "Intellect",
  "icon": "arc_gunner.png",
  "attributePriorities": {
    "Smarts": 4,
    "RangedAccuracy": 3
  },
  "effects": [
    {
      "id": "Static",
      "name": "Static Build-up",
      "description": "Your hair is standing up.",
      "duration": 8,
      "maxStacks": 6,
      "stats": {
        "Crit": 2
      }
    },
    {
      "id": "LiveWire",
      "name": "Live Wire",
      "description": "The gun is wired straight into you. Your hits jump to the next Shocked enemy in reach.",
      "duration": 5,
      "procs": [
        {
          "on": "hit",
          "when": { "casting": true },
          "maxPerTurn": 1,
          "actions": [
            {
              "do": "chain",
              "jumps": 1,
              "radius": 3.5,
              "effect": "#Shocked",
              "actions": [
                { "do": "damage", "type": "Energy", "min": 3, "max": 5, "scale": "Smarts", "scaleMult": 0.3 }
              ]
            }
          ]
        }
      ]
    }
  ],
  "tiers": [
    {
      "attributes": {
        "Recognition": 1
      },
      "newAbility": {
        "base": "Passive",
        "name": "Static Grip",
        "equipped": "ranged",
        "icon": "arc_gunner_t0.png",
        "description": "Every shot builds a little charge in the grip.",
        "procs": [
          {
            "on": "hit",
            "chance": 35,
            "actions": [
              { "do": "effect", "to": "self", "effect": "@Static" }
            ]
          }
        ]
      }
    },
    {
      "attributes": {
        "Smarts": 1
      },
      "newAbility": {
        "base": "Shot",
        "name": "Arc Round",
        "equipped": "ranged",
        "icon": "arc_gunner_t1.png",
        "description": "A bullet with a spark in it.",
        "impactVfx": "PA_Elementalist_ChainLightning.shockImpact",
        "actions": [
          { "do": "damage", "type": "Ballistic", "min": 2, "max": 4, "perRank": 1, "weapon": 0.5 },
          { "do": "damage", "type": "Energy", "min": 1, "max": 3, "scale": "Smarts", "scaleMult": 0.3 },
          { "do": "effect", "effect": "#Shocked" }
        ],
        "perk": {
          "name": "Live Round",
          "description": "The spark doesn't stop at the wound.",
          "addActions": [
            { "do": "chain", "jumps": 1, "radius": 3, "actions": [ { "do": "effect", "effect": "#Shocked" } ] }
          ]
        },
        "sound": "audio_licensed/arcgunner_round.wav"
      }
    },
    {
      "attributes": {
        "Smarts": 1
      },
      "newAbility": {
        "base": "Bolt",
        "name": "Forked Discharge",
        "icon": "arc_gunner_t2.png",
        "cooldown": 5,
        "staminaCost": 15,
        "description": "Lightning that hops between anything already Shocked.",
        "actions": [
          {
            "do": "chain",
            "jumps": 2,
            "radius": 3.5,
            "effect": "#Shocked",
            "actions": [
              { "do": "damage", "type": "Energy", "min": 3, "max": 5, "scale": "Smarts", "scaleMult": 0.3 }
            ]
          }
        ],
        "perk": {
          "name": "Branching Bolt",
          "description": "The bolt leaves its first target charged behind it.",
          "addActions": [
            { "do": "effect", "effect": "#Shocked" }
          ]
        }
      }
    },
    {
      "attributes": {
        "Toughness": 1
      },
      "newAbility": {
        "base": "Buff",
        "name": "Capacitor",
        "icon": "arc_gunner_t3.png",
        "cooldown": 14,
        "description": "Wrap yourself in stored charge.",
        "actions": [
          { "do": "shield", "amount": 4, "bonusPerStack": 3, "stacksOf": "@Static" }
        ],
        "perk": {
          "name": "Supercapacitor",
          "description": "What the shield was holding has to go somewhere when it fails.",
          "addProcs": [
            {
              "on": "shieldBreak",
              "maxPerTurn": 1,
              "radius": 2.5,
              "actions": [
                { "do": "damage", "type": "Energy", "min": 3, "max": 6, "scale": "Smarts", "scaleMult": 0.3, "bonusPerStack": 2, "stacksOf": "@Static", "stacksFrom": "self" },
                { "do": "effect", "effect": "#Shocked" }
              ]
            }
          ]
        }
      }
    },
    {
      "attributes": {
        "Smarts": 2
      },
      "newAbility": {
        "base": "Passive",
        "name": "Conductive",
        "icon": "arc_gunner_t4.png",
        "description": "Shocked targets leak current into their neighbours.",
        "procs": [
          {
            "on": "hit",
            "chance": 20,
            "radius": 2,
            "actions": [
              { "do": "damage", "type": "Energy", "min": 2, "max": 3, "ifTargetHas": "#Shocked" }
            ]
          }
        ]
      }
    },
    {
      "attributes": {
        "Smarts": 2,
        "Recognition": 1
      },
      "newAbility": {
        "base": "Shot",
        "name": "Thunder Slug",
        "equipped": "ranged",
        "icon": "arc_gunner_t5.png",
        "staminaCost": 25,
        "cooldown": 12,
        "description": "Dump the whole capacitor into one round.",
        "impactVfx": "PA_Prototype_Thunderclap.impactParticle",
        "sound": "sfx/arcgunner_slug.wav",
        "actions": [
          { "do": "damage", "type": "Energy", "min": 6, "max": 10, "scale": "Smarts", "scaleMult": 0.5, "perRank": 2, "bonusPerStack": 3, "stacksOf": "@Static", "stacksFrom": "self", "consumeStacks": true },
          { "do": "stun", "turns": 1, "ifTargetHas": "#Shocked" }
        ],
        "perk": {
          "name": "Lightning Slug",
          "description": "The round grounds through everything already carrying current.",
          "addActions": [
            { "do": "chain", "ifTargetHas": "#Shocked", "jumps": 2, "radius": 3.5, "effect": "#Shocked", "actions": [ { "do": "stun", "turns": 1 } ] }
          ]
        }
      }
    },
    {
      "attributes": {
        "Recognition": 1
      },
      "newAbility": {
        "base": "Passive",
        "name": "Ground Line",
        "icon": "SKILLTREE_Elementalist/1",
        "description": "Each jump of your lightning runs back down the line and into the grip.",
        "procs": [
          {
            "on": "chain",
            "maxPerTurn": 2,
            "actions": [
              { "do": "effect", "to": "self", "effect": "@Static" }
            ]
          }
        ]
      }
    },
    {
      "attributes": {
        "Smarts": 2
      },
      "newAbility": {
        "base": "Blast",
        "name": "Lightning Rod",
        "icon": "SKILLTREE_Elementalist/3",
        "range": 6,
        "radius": 0,
        "cooldown": 8,
        "staminaCost": 14,
        "description": "Plant a charged rod in the deck. The first two enemies to walk up to it take what it holds.",
        "actions": [
          {
            "do": "trap",
            "fieldName": "Lightning Rod",
            "affects": "enemies",
            "triggerRadius": 1.5,
            "radius": 1.5,
            "charges": 2,
            "maxTraps": 1,
            "look": "HAZARD_Energy@0.5",
            "vfx": "PA_Elementalist_ChainLightning.shockImpact",
            "sound": "sfx/arcgunner_slug.wav",
            "actions": [
              { "do": "damage", "type": "Energy", "min": 3, "max": 6, "scale": "Smarts", "scaleMult": 0.3, "perRank": 1 },
              { "do": "effect", "effect": "#Shocked" }
            ]
          }
        ],
        "perk": {
          "name": "Earthed Rod",
          "description": "The rod is wired to your grip, so what it discharges comes back to you.",
          "addProcs": [
            {
              "on": "trap",
              "match": "Lightning Rod",
              "actions": [
                { "do": "effect", "to": "self", "effect": "@Static", "stacks": 2 }
              ]
            }
          ]
        }
      }
    },
    {
      "attributes": {
        "Smarts": 2,
        "Recognition": 1
      },
      "newAbility": {
        "base": "Buff",
        "name": "Live Wire",
        "icon": "SKILLTREE_Elementalist/5",
        "cooldown": 16,
        "staminaCost": 20,
        "description": "Bypass the safety and wire the gun into yourself. For five turns, your hits jump to the next Shocked enemy in reach.",
        "castVfx": "PA_Engineer_Boltron.PS_shock",
        "actions": [
          { "do": "effect", "to": "self", "effect": "@LiveWire" }
        ],
        "perk": {
          "name": "Closed Circuit",
          "description": "Throwing the switch fills the grip at once.",
          "addActions": [
            { "do": "effect", "to": "self", "effect": "@Static", "stacks": 3 }
          ]
        }
      }
    }
  ]
}