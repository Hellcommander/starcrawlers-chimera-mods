      "name": "Rig Heat",
      "icon": "icons/heat.png",
      "debuff": true,
      "resource": true,
      "resourceColor": "#FF6A3D",
      "description": "The rig is running hot. Every point makes your hits land harder; at ten it overheats and you burn. It cools off if you give it a few turns, or vent it all at once.",
      "duration": 5,
      "maxStacks": 10,
      "burstAt": 10,
      "damageDealtPerStack": 0.04,
      "burstActions": [
        {
          "do": "effect",
          "effect": "EFFECT_Fire"
        },
        {
          "do": "stamina",
          "amount": -20
        }
      ],
      "burstSound": "audio_licensed/rig_overheat.wav"
    },
