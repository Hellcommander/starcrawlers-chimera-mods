      "newAbility": {
        "base": "Strike",
        "name": "Piston Jab",
        "icon": "icons/piston_jab.png",
        "staminaCost": 6,
        "cooldown": 0,
        "runeSlots": 2,
        "runeSlotRanks": [
          2,
          4
        ],
        "runeMeter": "@Heat",
        "description": "A hydraulic jab. Two hardpoints turn it into whatever you need: a flame-spitting punch, a magnetic yank, an overdriven bone-breaker.",
        "impactVfx": "PA_Shieldbearer_Charge.impactParticle@0.5",
        "actions": [
          {
            "do": "damage",
            "type": "Crushing",
            "min": 3,
            "max": 6,
            "scale": "Strength",
            "scaleMult": 0.4,
            "perRank": 1
          },
          {
            "do": "effect",
            "to": "self",
            "effect": "@Heat"
          }
        ],
        "runeVariants": [
          {
            "rune": "KnKineticRam",
            "name": "Pile Bunker",
            "replace": true,
            "description": "the ram fires a spike through the jab: they're thrown four tiles and stunned if they slam into anything.",
            "instability": 2,
            "actions": [
              {
                "do": "throw",
                "amount": 4,
                "actions": [
                  {
                    "do": "damage",
                    "type": "Crushing",
                    "min": 5,
                    "max": 8
                  },
                  {
                    "do": "stun",
                    "turns": 1
                  }
                ]
              }
            ]
          },
          {
            "rune": "KnMagnetClamp",
            "name": "Yo-Yo",
            "description": "yank them in, then jab them right back out a tile.",
            "actions": [
              {
                "do": "knockback",
                "amount": 1
              }
            ]
          },
          {
            "rune": "KnArcCoil",
            "name": "Taser Jab",
            "description": "the coil discharges through the knuckles: a quarter of the time they lock up for a turn.",
            "actions": [
              {
                "do": "stun",
                "turns": 1,
                "chance": 25
              }
            ]
          },
          {
            "rune": "KnCryoJacket",
            "name": "Cold Fist",
            "description": "a frosted fist: they come away slowed.",
            "actions": [
              {
                "do": "effect",
                "effect": "SLOW",
                "turns": 1
              }
            ]
          }
        ],
        "perk": {
          "name": "Double Stroke",
          "description": "On the return stroke the piston blows off steam, so jabs alone never tip the rig over.",
          "addActions": [
            {
              "do": "effect",
              "to": "self",
              "stacks": -2,
              "when": {
                "value": "stacks:@Heat",
                "of": "self",
                "atLeast": 9
              },
              "effect": "@Heat"
            }
          ]
        },
        "sound": "audio_licensed/rig_piston_jab.wav"
      }
    },
