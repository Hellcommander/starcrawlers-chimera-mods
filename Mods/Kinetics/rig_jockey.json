{
  "id": "MOD_RigJockey",
  "name": "Rig Jockey",
  "description": "Salvage crews strapped into cargo exo-rigs. Every hydraulic move takes bolt-on hardpoints - flamer nozzles, arc coils, magnet clamps - that change how it hits and are never used up.\n\nHeavy melee with hardware sockets and a Heat meter that raises damage until it overheats. The hardpoints also set off reactions: fire, current and frost meeting plating you have stripped, or each other, and the element hardpoints retune what Vent Blast leaves on them. Favors [STR] and [TGH].",
  "archetype": "Muscle",
  "icon": "icons/rig_jockey.png",
  "attributePriorities": {
    "Strength": 5,
    "Toughness": 3,
    "Smarts": 1
  },
  "starterItems": [
    "KnFlamerNozzle",
    "KnPistonOverdrive",
    "KnHeatSink",
    "KnMagnetClamp"
  ],
  "effects": [
