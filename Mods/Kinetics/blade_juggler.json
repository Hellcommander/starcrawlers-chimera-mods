      "id": "Nicked",
      "name": "Nicked",
      "debuff": true,
      "description": "A thin cut that keeps opening. More of them, more bleeding.",
      "duration": 3,
      "maxStacks": 5,
      "dot": {
        "type": "Slashing",
        "min": 1,
        "max": 2
      }
    },
    {
      "id": "Juggling",
      "name": "Juggling",
      "description": "Knives in the air and a rhythm in your hands.",
