{
  "id": "MOD_BladeJuggler",
  "name": "Blade Juggler",
  "description": "Knife-act performers from the orbital circuses. Thrown knives stick in the deck and cut whoever steps on them, until one call brings every blade home through everything in the way.\n\nThrow-and-recall skirmisher: the more knives out, the worse the return. Favors [AGL].",
  "archetype": "Guile",
  "icon": "icons/blade_juggler.png",
