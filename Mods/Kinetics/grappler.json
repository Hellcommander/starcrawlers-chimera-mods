    {
      "id": "Grip",
      "name": "Grip",
      "icon": "icons/grip.png",
      "description": "Your hands know where to go. Every layer of grip makes your blows land harder; the Piledriver spends it all.",
      "duration": 6,
      "maxStacks": 5,
      "resource": true,
      "resourceColor": "#FFB347",
      "stats": {
        "MeleePower": 2
      }
    },
    {
