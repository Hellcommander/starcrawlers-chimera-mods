{
  "id": "MOD_Grappler",
  "name": "Grappler",
  "description": "Cargo-dock wrestlers for whom a body is just freight with opinions. They drag enemies in, hold them so they can't act, and throw them into walls, each other and whatever burns.\n\nClose-range control bruiser. Grip builds from grabs and pays out in a deck-cracking Piledriver. Favors [STR] and [TGH].",
  "archetype": "Muscle",
  "icon": "icons/grappler.png",
  "attributePriorities": {
    "Strength": 5,
    "Toughness": 3
  },
  "effects": [
    {
      "id": "Grip",
      "name": "Grip",
      "icon": "icons/grip.png",
      "description": "Your hands know where to go. Every layer of grip makes your blows land harder; the Piledriver spends it all.",
      "duration": 6,
      "maxStacks": 5,
      "resource": true,
      "resourceColor": "#FFB347",
      "stats": {
        "MeleePower": 2
      }
    },
    {
      "id": "Held",
      "name": "Held",
      "debuff": true,
      "description": "Locked in a hold. Hard to dodge anything like this.",
      "duration": 1,
      "stats": {
        "Dodge": -20,
        "Agility": -2
      }
    },
    {
      "id": "Dazed",
      "name": "Dazed",
      "debuff": true,
      "description": "Their head is still ringing from the landing.",
      "duration": 2,
      "stats": {
        "Dodge": -10,
        "Agility": -2,
        "MeleePower": -2
      }
    },
    {
      "id": "Clinch",
      "name": "Iron Clinch",
      "description": "You are braced and waiting. Anyone who swings at you is likely to get caught.",
      "duration": 3,
      "stats": {
        "Block": 15,
        "Armor": 3
      },
      "procs": [
        {
          "on": "hurt",
          "chance": 50,
          "actions": [
            {
              "do": "effect",
              "to": "attacker",
              "effect": "@Held"
            },
            {
              "do": "stun",
              "to": "attacker",
              "turns": 1
            },
            {
              "do": "effect",
              "to": "self",
              "effect": "@Grip"
            }
          ]
        }
      ]
    }
  ],
