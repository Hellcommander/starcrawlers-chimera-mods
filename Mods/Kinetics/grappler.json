      "description": "Locked in a hold. Hard to dodge anything like this.",
      "duration": 1,
      "stats": {
        "Dodge": -20,
        "Agility": -2
      }
    },
    {
      "id": "Dazed",
      "name": "Dazed",
      "debuff": true,
