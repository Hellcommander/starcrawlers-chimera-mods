        "sound": "audio_licensed/guard_over_here.wav"
      }
    },
    {
      "attributes": {
        "Toughness": 1
      },
      "newAbility": {
        "base": "Buff",
        "name": "Retort Stance",
        "icon": "icons/retort_stance.png",
        "staminaCost": 10,
        "cooldown": 8,
        "description": "Set yourself to answer back. For the next few turns, whoever hurts you or one of your people eats a counter-punch - harder the more Resolve you carry.",
        "actions": [
          {
            "do": "arm",
            "reaction": {
              "name": "Counter-Punch",
              "on": "hurt",
              "who": "allies",
              "charges": 3,
              "turns": 6,
              "priority": 55,
              "vfx": "PA_Shieldbearer_Charge.impactParticle@0.4",
              "actions": [
                {
                  "do": "damage",
                  "type": "Crushing",
                  "min": 4,
                  "max": 7,
                  "scale": "Strength+Toughness",
                  "scaleMult": 0.25,
                  "perRank": 1,
                  "bonusPerStack": 1,
                  "stacksOf": "@Resolve",
                  "stacksFrom": "self"
                },
                {
                  "do": "effect",
                  "effect": "@Staggered"
                }
              ]
            }
          }
        ],
        "perk": {
          "name": "Quick Hands",
          "cooldownDelta": -3
        },
        "sound": "audio_licensed/guard_retort_stance.wav"
      }
    },
    {
      "attributes": {
        "Strength": 2,
        "Toughness": 1
      },
      "newAbility": {
        "base": "Strike",
        "name": "Payback",
        "icon": "icons/payback.png",
        "staminaCost": 20,
        "cooldown": 10,
        "description": "Everything they put into you, back out at once. Every layer of Resolve goes into one punch that stuns and sends them flying.",
        "impactVfx": "PA_Barbarian_FlyingSmash.triggerParticle@0.5",
        "sound": "audio_licensed/guard_payback.wav",
        "actions": [
          {
            "do": "damage",
            "type": "Crushing",
            "min": 8,
            "max": 12,
            "scale": "Strength+Toughness",
            "scaleMult": 0.35,
            "perRank": 2,
            "bonusPerStack": 4,
            "stacksOf": "@Resolve",
            "stacksFrom": "self",
