        "actions": [
          {
            "do": "taunt",
            "to": "self",
            "radius": 4,
            "turns": 2
          },
          {
            "do": "effect",
            "to": "self",
            "effect": "@Braced"
          },
          {
            "do": "effect",
            "to": "self",
            "effect": "@Resolve",
            "stacks": 2
          }
        ],
        "perk": {
          "name": "Booming Voice",
          "cooldownDelta": -3
