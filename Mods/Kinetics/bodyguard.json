        "perk": {
          "name": "Make Some Room",
          "radiusDelta": 1
        },
        "sound": "audio_licensed/guard_shoulder_check.wav"
      }
    },
    {
      "attributes": {
        "Toughness": 2,
        "Strength": 1
      },
      "newAbility": {
        "base": "Passive",
        "name": "Iron Oath",
        "icon": "icons/iron_oath.png",
        "description": "You swore nobody gets past you, and you meant it. When you are close to dropping, you dig in: a shield built from your Resolve, a brace, and more Resolve. When one of your people falls anyway, the anger hardens you and puts weight behind your hands.",
        "procs": [
          {
            "on": "lowHealth",
            "threshold": 35,
            "cooldown": 18,
            "actions": [
              {
                "do": "shield",
                "to": "self",
                "amount": 8,
                "perRank": 1,
                "bonusPerStack": 2,
                "stacksOf": "@Resolve",
