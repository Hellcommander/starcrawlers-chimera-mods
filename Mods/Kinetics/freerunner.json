{
  "id": "MOD_Freerunner",
  "name": "Freerunner",
  "description": "Station kids who learned the vents and stairwells before they could read. Every tile they cover builds Momentum; standing still lets it bleed away.\n\nMovement-driven skirmisher: dodge and crit from Momentum, mobility that builds it, finishers that spend it. Favors [AGL].",
  "archetype": "Guile",
  "icon": "icons/freerunner.png",
  "attributePriorities": {
    "Agility": 5,
    "Strength": 2
  },
  "effects": [
    {
      "id": "Momentum",
      "name": "Momentum",
      "icon": "icons/momentum.png",
      "resource": true,
      "resourceColor": "#7CFFB2",
      "description": "You're on the move. Every stack makes you harder to hit and your strikes sharper. Stop moving for a couple of turns and it's gone.",
      "duration": 2,
      "maxStacks": 8,
      "stats": {
        "Dodge": 3,
        "Crit": 2
      }
    },
    {
      "id": "Airborne",
      "name": "Airborne",
      "description": "Mid-vault. Very hard to hit.",
      "duration": 1,
      "stats": {
        "Dodge": 25
      }
    },
    {
      "id": "Tripped",
      "name": "Tripped",
      "debuff": true,
      "description": "Swept off their feet.",
      "duration": 2,
      "stats": {
        "Dodge": -15,
        "Agility": -2
      }
    }
  ],
  "tiers": [
    {
      "attributes": {
        "Agility": 1
      },
      "newAbility": {
        "base": "Passive",
        "name": "Flow State",
        "icon": "icons/flow_state.png",
        "description": "Every step you take builds Momentum. Waiting in place throws it away.",
        "procs": [
          {
            "on": "move",
            "actions": [
              {
                "do": "effect",
                "to": "self",
                "effect": "@Momentum"
              }
            ]
          },
          {
            "on": "wait",
            "actions": [
              {
                "do": "purge",
                "to": "self",
                "effect": "@Momentum"
              }
            ]
          }
        ]
      }
    },
    {
      "attributes": {
        "Agility": 1
      },
      "newAbility": {
        "base": "Strike",
        "name": "Flying Knee",
        "icon": "icons/flying_knee.png",
        "staminaCost": 6,
        "cooldown": 0,
        "description": "A jumping knee that hits harder the faster you're going, and keeps you going.",
        "impactVfx": "PA_Barbarian_SweepingStrike.triggerParticle@0.5",
        "actions": [
          {
            "do": "damage",
            "type": "Crushing",
            "min": 2,
            "max": 5,
            "scale": "Agility",
            "scaleMult": 0.4,
            "perRank": 1,
            "bonusPerStack": 1,
            "stacksOf": "@Momentum",
