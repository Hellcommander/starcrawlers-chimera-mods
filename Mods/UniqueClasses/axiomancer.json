                "else": [ { "do": "effect", "to": "self", "effect": "@Insight" },
                          { "do": "effect", "to": "self", "effect": "@Insight", "when": { "value": "Smarts", "of": "self", "atLeast": 14 } } ] },
              { "do": "counter", "to": "self", "counter": "ProofStep", "amount": 4, "counterSet": true }
