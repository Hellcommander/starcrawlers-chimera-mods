{
  "id": "MOD_Axiomancer",
  "name": "Axiomancer",
  "description": "A scholar who found out that a sufficiently rigorous thought has mass. They study a target until they understand it completely, then argue it out of existence. Every new line of reasoning sharpens the mind; saying the same thing twice only goes in circles.\n\nSmarts become Psi Power in several ways: casting a different skill than the last builds Insight (+Psi Power per stack, faster with high Smarts) while repeating one builds Circular Reasoning; Cold Read files a Case Study on an enemy that Refutation and Chain of Inference cash in; waiting or resting on full stamina turns into Insight; and Lucid Apotheosis converts your Smarts into Psi Power outright. Both stats are then put to work: most attacks scale with Smarts and Psi Power together, Refutation and Cognitive Shell change what they do depending on which of the two leads, and the Shell spends your Insight on shields, stamina and cooldowns. Favors [SMT] and [PSI].",
  "archetype": "Intellect",
  "icon": "axiomancer.png",
  "attributePriorities": {
    "Smarts": 4,
    "PsiPower": 4,
    "Toughness": 1
  },
  "conditions": {
    "AxiomSmartsLed": { "any": [
      { "all": [ { "value": "Smarts", "of": "self", "atLeast": 8 }, { "value": "PsiPower", "of": "self", "below": 8 } ] },
      { "all": [ { "value": "Smarts", "of": "self", "atLeast": 12 }, { "value": "PsiPower", "of": "self", "below": 12 } ] },
      { "all": [ { "value": "Smarts", "of": "self", "atLeast": 16 }, { "value": "PsiPower", "of": "self", "below": 16 } ] },
      { "all": [ { "value": "Smarts", "of": "self", "atLeast": 20 }, { "value": "PsiPower", "of": "self", "below": 20 } ] },
      { "all": [ { "value": "Smarts", "of": "self", "atLeast": 24 }, { "value": "PsiPower", "of": "self", "below": 24 } ] },
      { "all": [ { "value": "Smarts", "of": "self", "atLeast": 30 }, { "value": "PsiPower", "of": "self", "below": 30 } ] }
    ] },
    "AxiomPsiLed": { "any": [
      { "all": [ { "value": "PsiPower", "of": "self", "atLeast": 8 }, { "value": "Smarts", "of": "self", "below": 8 } ] },
      { "all": [ { "value": "PsiPower", "of": "self", "atLeast": 12 }, { "value": "Smarts", "of": "self", "below": 12 } ] },
      { "all": [ { "value": "PsiPower", "of": "self", "atLeast": 16 }, { "value": "Smarts", "of": "self", "below": 16 } ] },
      { "all": [ { "value": "PsiPower", "of": "self", "atLeast": 20 }, { "value": "Smarts", "of": "self", "below": 20 } ] },
      { "all": [ { "value": "PsiPower", "of": "self", "atLeast": 24 }, { "value": "Smarts", "of": "self", "below": 24 } ] },
      { "all": [ { "value": "PsiPower", "of": "self", "atLeast": 30 }, { "value": "Smarts", "of": "self", "below": 30 } ] }
    ] }
  },
  "effects": [
    {
      "id": "Insight",
      "name": "Insight",
      "description": "Each fresh line of reasoning adds weight to the next one. It fades if you stop thinking new thoughts.",
      "duration": 5,
      "maxStacks": 8,
      "resource": true,
      "resourceColor": "#B48CFF",
      "stats": {
        "PsiPower": 1
      }
    },
    {
      "id": "Circular",
      "name": "Circular Reasoning",
      "description": "You have made this argument already, and it was no better the first time. At three stacks the whole train of thought derails: your Insight is lost and your blows go soft for a while.",
      "duration": 3,
      "debuff": true,
      "resource": true,
      "maxStacks": 3,
      "damageDealtPerStack": -0.08,
      "burstAt": 3,
      "burstActions": [
        { "do": "purge", "to": "self", "effect": "@Insight" },
        { "do": "effect", "to": "self", "effect": "#Weakened", "turns": 2 }
      ]
    },
    {
      "id": "CaseStudy",
      "name": "Case Study",
      "description": "You have been taking notes on it. Every note is another way its mind can be argued into a corner.",
      "duration": 6,
      "debuff": true,
      "maxStacks": 5,
      "resists": {
        "Psi": -4
      }
    },
    {
      "id": "Hypothesis",
      "name": "Working Hypothesis",
      "description": "An idea that was never disproven and so decided to stand up. It studies whatever it strikes, and if it is ever refuted, the lesson stays with its author.",
      "duration": -1,
      "damageDealtMult": 1.25,
      "damageTakenMult": 0.8,
      "resists": {
        "Psi": 25
      },
      "procs": [
        { "on": "hit", "actions": [ { "do": "effect", "effect": "@CaseStudy" } ] }
      ],
      "onDeathActions": [
        { "do": "effect", "to": "self", "effect": "@Insight", "stacks": 3 }
      ]
    },
    {
      "id": "Lucidity",
      "name": "Lucidity",
      "description": "For a few moments, knowing a thing and doing it are the same act. Every stack is Psi Power drawn straight out of your Smarts, and every skill you use adds to your Insight.",
      "duration": 4,
      "maxStacks": 6,
      "stats": {
        "PsiPower": 3
      },
      "onApplyActions": [
        { "do": "purge", "to": "self", "effect": "@Circular" }
      ],
      "procs": [
        { "on": "cast", "actions": [ { "do": "effect", "to": "self", "effect": "@Insight" } ] }
      ]
    }
  ],
  "tiers": [
    {
      "attributes": {
        "Smarts": 1
      },
      "newAbility": {
        "base": "Passive",
        "name": "First Principles",
        "icon": "axiomancer_t0.png",
        "description": "Never make the same argument twice in a row.",
        "rules": "• Using a skill other than the one you used last gives <color=#B48CFF>Insight</color> (+1 Psi Power each), two with 14 Smarts.\n• Using the same skill again gives <color=#FF7272>Circular Reasoning</color> instead (-8% damage per stack; at 3 you lose your Insight and are Weakened).\n• Cold Read is only observation: repeating it gives nothing either way.",
        "procs": [
          {
            "on": "cast",
            "match": "MOD_Axiomancer_T1",
            "actions": [
              { "do": "if", "to": "self", "when": { "value": "counter:ProofStep", "of": "self", "is": 1 },
                "then": [],
                "else": [ { "do": "effect", "to": "self", "effect": "@Insight" } ] },
              { "do": "counter", "to": "self", "counter": "ProofStep", "amount": 1, "counterSet": true }
            ]
          },
          {
            "on": "cast",
            "match": "MOD_Axiomancer_T2",
            "actions": [
