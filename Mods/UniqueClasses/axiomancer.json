    {
      "attributes": {
        "PsiPower": 1
      },
      "newAbility": {
        "base": "Bolt",
        "name": "Cold Read",
        "icon": "axiomancer_t1.png",
        "staminaCost": 8,
        "description": "Look at it properly for once. The flinch, the habits, the tell: all of it goes into the Case Study, and the glare alone hurts. With 12 Smarts you take twice the notes.",
        "impactVfx": "PA_Hacker_Virus_Mindmelt.PS_mindmelt_impact",
        "sound": "event:/Abilities/VoidPsyker/VoidPsyker_Cast",
        "actions": [
          { "do": "damage", "type": "Psi", "min": 2, "max": 4, "scale": "Smarts", "scaleMult": 0.35, "perRank": 1 },
          { "do": "effect", "effect": "@CaseStudy" },
          { "do": "effect", "effect": "@CaseStudy", "when": { "value": "Smarts", "of": "self", "atLeast": 12 } }
        ],
        "perk": {
          "name": "Second Glance",
          "addActions": [
            { "do": "effect", "effect": "@CaseStudy" }
          ]
        }
      }
    },
    {
      "attributes": {
        "Smarts": 1
      },
      "newAbility": {
        "base": "Bolt",
        "name": "Refutation",
        "icon": "axiomancer_t2.png",
        "staminaCost": 14,
        "cooldown": 4,
        "description": "Read your notes back to it, all of them, in order. Every entry in its Case Study is spent as Psi damage, and a thoroughly studied mind (4 or more notes) is left with nothing to say. How you argue depends on which is ahead: when your Smarts lead your Psi Power by a step (8, 12, 16, 20, 24, 30), the rebuttal also stalls its big moves by 2 turns; when your Psi Power leads, it lands with a second, harder Psi blow.",
        "impactVfx": "PA_Psykonics_Dominate.castParticle",
        "sound": "event:/Abilities/Misc/Psykonics_Dominate",
        "actions": [
          { "do": "silence", "turns": 1, "when": { "value": "stacks:@CaseStudy", "of": "target", "atLeast": 4 } },
          { "do": "exhaust", "amount": 2, "when": "AxiomSmartsLed" },
          { "do": "damage", "type": "Psi", "min": 3, "max": 5, "scale": "PsiPower", "scaleMult": 0.25, "when": "AxiomPsiLed" },
          { "do": "damage", "type": "Psi", "min": 4, "max": 7, "scale": "Smarts+PsiPower", "scaleMult": 0.25, "perRank": 1, "bonusPerStack": 3, "stacksOf": "@CaseStudy", "stacksFrom": "target", "consumeStacks": true }
        ],
        "perk": {
          "name": "Counterexample",
          "cooldownDelta": -2
        }
      }
    },
    {
      "attributes": {
        "Smarts": 1,
        "PsiPower": 1
      },
      "newAbility": {
        "base": "Passive",
        "name": "Quiet Mind",
        "icon": "axiomancer_t3.png",
        "description": "A mind left idle cools into clarity. Waiting a turn gives Insight (more with 16 Smarts), recovers stamina in proportion to your Smarts and clears the last argument, so you may repeat yourself. Ending a turn in a fight with your stamina nearly full turns the unspent effort into Insight.",
        "procs": [
          {
            "on": "wait",
            "actions": [
              { "do": "effect", "to": "self", "effect": "@Insight", "stacks": 2 },
              { "do": "effect", "to": "self", "effect": "@Insight", "when": { "value": "Smarts", "of": "self", "atLeast": 16 } },
              { "do": "stamina", "to": "self", "amount": 3, "scale": "Smarts", "scaleMult": 0.3 },
              { "do": "counter", "to": "self", "counter": "ProofStep", "amount": 0, "counterSet": true }
            ]
          },
          {
            "on": "turn",
            "cooldown": 2,
            "when": { "all": [ { "inCombat": true }, { "value": "stamina%", "of": "self", "atLeast": 90 } ] },
            "actions": [
              { "do": "effect", "to": "self", "effect": "@Insight" }
            ]
          }
        ]
      }
    },
    {
      "attributes": {
        "Toughness": 1,
        "Smarts": 1
      },
      "newAbility": {
        "base": "Buff",
        "name": "Cognitive Shell",
        "icon": "axiomancer_t4.png",
        "cooldown": 12,
        "description": "Close the argument and spend what it taught you.",
        "rules": "• Spends all your Insight: overshield of 4 (+0.3 per Smarts and Psi Power, +2 per Insight). Clears Circular Reasoning.\n• Smarts lead: other cooldowns -2 and stamina 2 (+0.2 per Smarts, +2 per Insight).\n• Psi Power leads: 4 more overshield (+1 per Insight) and Fortified.\n• Even: other cooldowns -1 and 3 more overshield.\n• A stat leads when it has reached a step (8, 12, 16, 20, 24, 30) the other hasn't.",
        "castVfx": "PA_ThoughtLeader_FI.castParticle",
        "sound": "event:/Abilities/ForcePsyker/Smite_PowerUp",
        "actions": [
          { "do": "if", "to": "self", "when": "AxiomSmartsLed",
            "then": [ { "do": "cooldowns", "amount": 2 },
                      { "do": "stamina", "to": "self", "amount": 2, "scale": "Smarts", "scaleMult": 0.2, "bonusPerStack": 2, "stacksOf": "@Insight", "stacksFrom": "self" } ],
            "else": [ { "do": "if", "to": "self", "when": "AxiomPsiLed",
              "then": [ { "do": "shield", "to": "self", "amount": 4, "bonusPerStack": 1, "stacksOf": "@Insight", "stacksFrom": "self" },
                        { "do": "effect", "to": "self", "effect": "#Fortified" } ],
              "else": [ { "do": "cooldowns", "amount": 1 },
                        { "do": "shield", "to": "self", "amount": 3 } ] } ] },
          { "do": "shield", "to": "self", "amount": 4, "scale": "Smarts+PsiPower", "scaleMult": 0.3, "bonusPerStack": 2, "stacksOf": "@Insight", "stacksFrom": "self", "consumeStacks": true },
          { "do": "purge", "to": "self", "effect": "@Circular" }
        ],
        "perk": {
          "name": "Airtight",
          "cooldownDelta": -3
        }
      }
    },
    {
      "attributes": {
        "PsiPower": 2,
        "Smarts": 1
      },
      "newAbility": {
        "base": "Bolt",
        "name": "Chain of Inference",
        "icon": "axiomancer_t5.png",
        "range": 6,
        "staminaCost": 20,
        "cooldown": 7,
        "description": "If this one thinks like that, then so does that one, and that one. The conclusion strikes the target and leaps on to up to three more enemies you have a Case Study on, adding a note to each.",
        "impactVfx": "PA_ThoughtLeader_JoinUs.PS_Impact",
        "sound": "event:/Abilities/Misc/Psykonics_Warp",
        "actions": [
          { "do": "chain", "jumps": 3, "radius": 3, "effect": "@CaseStudy", "falloff": 0.85, "actions": [
            { "do": "damage", "type": "Psi", "min": 5, "max": 8, "scale": "Smarts+PsiPower", "scaleMult": 0.3, "perRank": 1 },
            { "do": "effect", "effect": "@CaseStudy" } ] }
        ],
        "perk": {
          "name": "Sound Logic",
          "damageMult": 1.25
        }
      }
    },
    {
      "attributes": {
        "Smarts": 2,
        "PsiPower": 1
      },
      "newAbility": {
        "base": "Bolt",
        "name": "Living Hypothesis",
        "icon": "axiomancer_t6.png",
        "range": 6,
        "staminaCost": 22,
        "cooldown": 6,
        "description": "Give an untested idea a body and point it at the target. One Hypothesis at a time: it grows stronger with your Smarts, adds to the Case Study of whatever it hits, and if it is ever destroyed you keep what it learned as Insight. Use this again while it stands to put it to the test: a Psi blow on the target that is heavier for every note in its Case Study (the notes stay), and the Hypothesis mends.",
        "castVfx": "PA_ThoughtLeader_FI.castParticle",
        "impactVfx": "PA_Hacker_Virus_Mindmelt.PS_mindmelt_impact",
        "sound": "event:/Abilities/Misc/Psykonics_Telekinesis",
        "actions": [
          { "do": "damage", "type": "Psi", "min": 6, "max": 10, "scale": "Smarts+PsiPower", "scaleMult": 0.3, "perRank": 2, "bonusPerStack": 2, "stacksOf": "@CaseStudy", "stacksFrom": "target", "ifSummonAlive": "self" },
          { "do": "heal", "to": "summon", "amount": 10, "perRank": 2, "ifSummonAlive": "self" },
          { "do": "effect", "effect": "@CaseStudy", "stacks": 2, "unlessSummonAlive": "self" },
          { "do": "summon", "to": "self", "creature": "nanite_cloud", "summonName": "Hypothesis", "amount": 1, "maxSummons": 1, "turns": 15, "effect": "@Hypothesis", "unlessSummonAlive": "self" }
        ],
        "perk": {
          "name": "Peer Review",
          "cooldownDelta": -2
        }
      }
    },
    {
      "attributes": {
        "PsiPower": 2,
        "Smarts": 1
      },
      "newAbility": {
        "base": "Buff",
        "name": "Lucid Apotheosis",
        "icon": "axiomancer_t7.png",
        "staminaCost": 20,
        "cooldown": 18,
        "description": "Stop thinking about the power and simply understand it. You gain one stack of Lucidity, plus one more for each of 8, 12, 16, 20 and 24 Smarts you have: +3 Psi Power per stack for 4 turns. While it lasts, every skill you use adds Insight, and Circular Reasoning is cleared the moment it begins.",
        "castVfx": "VoidPsyker_Ascendance.impactParticle",
        "sound": "event:/Abilities/VoidPsyker/VoidPsyker_Ascendance_Cast",
        "actions": [
          { "do": "effect", "to": "self", "effect": "@Lucidity" },
          { "do": "effect", "to": "self", "effect": "@Lucidity", "when": { "value": "Smarts", "of": "self", "atLeast": 8 } },
          { "do": "effect", "to": "self", "effect": "@Lucidity", "when": { "value": "Smarts", "of": "self", "atLeast": 12 } },
          { "do": "effect", "to": "self", "effect": "@Lucidity", "when": { "value": "Smarts", "of": "self", "atLeast": 16 } },
          { "do": "effect", "to": "self", "effect": "@Lucidity", "when": { "value": "Smarts", "of": "self", "atLeast": 20 } },
          { "do": "effect", "to": "self", "effect": "@Lucidity", "when": { "value": "Smarts", "of": "self", "atLeast": 24 } }
        ],
        "perk": {
          "name": "Sustained Clarity",
          "cooldownDelta": -4
        }
      }
    },
    {
      "attributes": {
        "Smarts": 2,
        "PsiPower": 2
      },
      "newAbility": {
        "base": "Nova",
        "name": "Grand Synthesis",
        "icon": "axiomancer_t8.png",
        "radius": 3.5,
        "staminaCost": 30,
        "cooldown": 20,
        "description": "Every note, every insight, every argument you have made in this fight, stated at once and all around you. Each enemy in reach takes Psi damage that grows with your Smarts and Psi Power, with every note in its Case Study (all of them spent) and with every Insight you hold (all of it spent once the proof is done). Minds you studied closely (3 or more notes) are left speechless, and if you are Lucid when you publish, nobody nearby can move for a moment.",
        "castVfx": "VoidPsyker_Ascendance.impactParticle",
        "impactVfx": "PA_Hacker_Virus_Mindmelt.PS_mindmelt_impact",
        "sound": "event:/Abilities/Misc/Psykonics_Dominate",
        "actions": [
          { "do": "silence", "turns": 2, "when": { "value": "stacks:@CaseStudy", "of": "target", "atLeast": 3 } },
          { "do": "stun", "turns": 1, "ifSelfHas": "@Lucidity" },
          { "do": "damage", "type": "Psi", "min": 2, "max": 4, "bonusPerStack": 2, "stacksOf": "@Insight", "stacksFrom": "self" },
          { "do": "damage", "type": "Psi", "min": 6, "max": 10, "scale": "Smarts+PsiPower", "scaleMult": 0.35, "perRank": 2, "bonusPerStack": 3, "stacksOf": "@CaseStudy", "stacksFrom": "target", "consumeStacks": true },
          { "do": "purge", "to": "self", "effect": "@Insight" },
          { "do": "purge", "to": "self", "effect": "@Circular" }
        ],
        "perk": {
          "name": "Elegant Proof",
          "radiusDelta": 1
        }
      }
    }
  ]
