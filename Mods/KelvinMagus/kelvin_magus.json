{
  "id": "MOD_KelvinMagus",
  "name": "Kelvin Magus",
  "description": "Thermodynamicists of the frost. To them cold is only heat taken away, and the heat has to go somewhere.\n\nFrost spells pull the heat out of enemies: four layers of Supercooled freeze them solid. The heat comes back to you as Stolen Heat, which feeds the Glacier Sentinel or vents as a Thermal Plume, and fire on a frozen enemy cracks it apart. Hoard ten and you overheat. Favors [SMT] and [PSI].",
  "archetype": "Intellect",
  "icon": "icons/kelvin_magus.png",
  "iconFrom": "SKILLTREE_Elementalist",
  "attributePriorities": { "Smarts": 4, "PsiPower": 4, "Toughness": 1 },
  "effects": [
    { "id": "StolenHeat", "name": "Stolen Heat", "icon": "icons/stolen_heat.png", "resource": true, "resourceColor": "#FF9A4A",
      "description": "Heat you pulled out of your targets. The Glacier Sentinel runs on it and Thermal Plume vents it. It leaks away if you pace yourself; hold ten and you overheat.",
      "duration": 8, "maxStacks": 10, "burstAt": 10, "burstSound": "sfx/km_overheat.wav", "burstVfx": "KmSteamJet@0.6",
      "burstActions": [ { "do": "effect", "to": "self", "effect": "@Overheated" } ] },
    { "id": "Overheated", "name": "Overheated", "icon": "icons/overheated.png", "debuff": true,
      "description": "You hoarded more heat than a body can hold. It cooks you from the inside: you take fire damage every turn, your spells hit softer and your stamina lags.",
      "duration": 3, "damageDealtMult": 0.75, "stats": { "StaminaRegen": -4 }, "dot": { "type": "Fire", "min": 2, "max": 3 },
      "vfx": "EFFECT_Fire" },
    { "id": "Supercooled", "name": "Supercooled", "icon": "icons/supercooled.png", "debuff": true,
      "description": "The heat is being drawn out of it: slower, easier to hit, and fire bites deeper. At four layers it freezes solid.",
      "duration": 5, "maxStacks": 4, "stats": { "Dodge": -3, "Agility": -1 }, "resists": { "Fire": -5 },
      "dot": { "type": "Cryo", "min": 1, "max": 1 }, "vfx": "EFFECT_Freezing_Blood",
      "burstAt": 4, "burstVfx": "KmFreeze", "burstSound": "audio_licensed/km_palisade.wav",
      "burstActions": [ { "do": "effect", "effect": "@FrozenSolid" }, { "do": "stun", "turns": 1 } ] },
    { "id": "FrozenSolid", "name": "Frozen Solid", "icon": "icons/frozen_solid.png", "debuff": true,
      "description": "Frozen through. It can't dodge and takes a quarter more damage. Fire on it cracks it with Thermal Fracture; Shatterpoint breaks it.",
      "duration": 2, "damageTakenMult": 1.25, "stats": { "Dodge": -30 }, "vfx": "EFFECT_Root_Frozen" },
    { "id": "IcedFooting", "name": "Iced Footing", "debuff": true, "icon": "icons/permafrost.png",
      "description": "Standing on frozen deck: it slips and the cold gets in.",
      "duration": 2, "stats": { "Dodge": -8 }, "resists": { "Cryo": -10 } },
    { "id": "Frostbound", "name": "Frostbound", "icon": "icons/glacier_sentinel.png",
      "description": "A walking engine of glacier ice. It takes hits softly, its blows supercool, and when it breaks the cold leaps to the nearest enemies.",
      "duration": -1, "damageTakenMult": 0.75, "stats": { "Toughness": 3 },
      "procs": [
        { "on": "hit", "actions": [ { "do": "effect", "effect": "@Supercooled" } ] },
        { "on": "hurt", "chance": 35, "actions": [ { "do": "effect", "to": "attacker", "effect": "@Supercooled" } ] } ],
      "onDeathActions": [
        { "do": "chain", "jumps": 3, "radius": 3, "vfx": "KmShatter@0.6",
          "actions": [ { "do": "damage", "type": "Cryo", "min": 4, "max": 8, "scale": "Smarts+PsiPower", "scaleMult": 0.2 },
                       { "do": "effect", "effect": "@Supercooled", "stacks": 2 } ] } ] }
  ],
  "reactions": [
    { "name": "Thermal Fracture", "needs": [ "@FrozenSolid", "EFFECT_Fire" ], "radius": 1.5, "consume": true,
      "description": "heat on frozen flesh: it cracks apart and the shards cut everything nearby",
      "vfx": "KmShatter", "sound": "audio_licensed/km_thermal_shock.wav",
      "actions": [ { "do": "damage", "type": "Crushing", "min": 8, "max": 14, "scale": "Smarts+PsiPower", "scaleMult": 0.3 } ] }
  ],
  "tiers": [
    { "attributes": { "Smarts": 1 }, "addResistances": { "Cryo": 5 },
      "newAbility": {
        "base": "Passive", "name": "Heat Pump", "icon": "icons/heat_pump.png",
        "description": "Everything you strike gives up a little warmth. When something dies cold, what was left of its heat gives you your breath back.",
        "procs": [
          { "on": "hit", "chance": 30, "actions": [ { "do": "effect", "effect": "@Supercooled" } ] },
          { "on": "kill", "when": { "any": [ { "has": "@Supercooled", "of": "victim" }, { "has": "@FrozenSolid", "of": "victim" } ] },
            "actions": [ { "do": "stamina", "to": "self", "amount": 4 } ] } ] } },

    { "attributes": { "PsiPower": 1 },
      "newAbility": {
        "base": "Bolt", "name": "Heat Siphon", "icon": "icons/heat_siphon.png", "range": 6, "staminaCost": 6, "cooldown": 0,
        "description": "Reach into a target and pull its heat out through the air. It chills; you keep the warmth.",
        "castVfx": "KmSiphonCast", "travelVfx": "KmSiphonBolt", "travelSpeed": 12, "impactVfx": "KmFrostHit",
        "sound": "sfx/km_siphon.wav",
        "actions": [
          { "do": "damage", "type": "Cryo", "min": 2, "max": 5, "scale": "Smarts+PsiPower", "scaleMult": 0.25, "perRank": 1 },
          { "do": "effect", "effect": "@Supercooled" },
          { "do": "effect", "to": "self", "effect": "@StolenHeat" } ],
        "perk": { "name": "Deep Draw", "addActions": [ { "do": "effect", "effect": "@Supercooled" } ] } } },

    { "attributes": { "Smarts": 1 }, "addResistances": { "Cryo": 5 },
      "newAbility": {
        "name": "Permafrost", "icon": "icons/permafrost.png", "target": "floor", "range": 6, "radius": 1.5,
        "staminaCost": 9, "cooldown": 5,
        "description": "Freeze the deck itself. Anyone standing on it slips, supercools and freezes in time. You steal heat from each enemy it catches.",
        "areaVfx": "KmPermafrostCast", "sound": "audio_licensed/km_permafrost.wav",
        "actions": [
          { "do": "field", "fieldName": "Permafrost", "turns": 4, "radius": 1.5, "affects": "enemies",
            "look": "HAZARD_Cryo@0.5", "pulseVfx": "KmFrostMist",
            "actions": [ { "do": "damage", "type": "Cryo", "min": 1, "max": 2, "perRank": 1 },
                         { "do": "effect", "effect": "@IcedFooting" },
                         { "do": "effect", "effect": "@Supercooled" } ] },
          { "do": "effect", "to": "self", "effect": "@StolenHeat" } ],
        "perk": { "name": "Long Winter", "cooldownDelta": -2 } } },

    { "attributes": { "PsiPower": 1, "Toughness": 1 },
      "newAbility": {
        "name": "Glacier Sentinel", "icon": "icons/glacier_sentinel.png", "target": "self", "staminaCost": 12, "cooldown": 10,
        "stackCost": { "effect": "@StolenHeat", "amount": 3 },
        "description": "Pour three Stolen Heat into an engine of glacier ice and it stands up beside you as a golem that fights for you. Use it again while it stands: it bellows, draws every enemy within three tiles onto itself, and you shield it.",
        "castVfx": "KmSentinelCall", "sound": "audio_licensed/km_sentinel.wav",
        "actions": [
          { "do": "summon", "creature": "GlacierSentinel", "summonVfx": "KmSentinelCall",
            "unlessSummonAlive": "self", "maxSummons": 1, "turns": 20, "effect": "@Frostbound" },
          { "do": "taunt", "to": "summons", "ifSummonAlive": "self", "radius": 3, "turns": 2 },
          { "do": "shield", "to": "summon", "ifSummonAlive": "self", "amount": 10, "perRank": 3 } ],
        "perk": { "name": "Old Ice", "cooldownDelta": -3 } } },

    { "attributes": { "Smarts": 1 },
      "newAbility": {
        "base": "Bolt", "name": "Thermal Plume", "icon": "icons/thermal_plume.png", "range": 5, "staminaCost": 6, "cooldown": 3,
        "usableWhen": { "value": "stacks:@StolenHeat", "of": "self", "atLeast": 1 },
        "description": "Vent everything you've stolen in one jet of scalding steam. It hits harder for every Stolen Heat, sets the target burning, and gives you back a little stamina for each. Fire on a frozen enemy sets off Thermal Fracture.",
        "castVfx": "KmSteamJet@0.5", "travelVfx": "KmSteamBolt", "travelSpeed": 10, "impactVfx": "KmSteamJet@0.7",
        "sound": "sfx/km_plume.wav",
        "actions": [
          { "do": "stamina", "to": "self", "amount": 1, "bonusPerStack": 1, "stacksOf": "@StolenHeat", "stacksFrom": "self" },
          { "do": "damage", "type": "Fire", "min": 3, "max": 6, "scale": "Smarts+PsiPower", "scaleMult": 0.25, "perRank": 1,
            "bonusPerStack": 3, "stacksOf": "@StolenHeat", "stacksFrom": "self", "consumeStacks": true },
          { "do": "effect", "effect": "EFFECT_Fire" } ],
        "perk": { "name": "Pressure Valve", "damageMult": 1.25 } } },

    { "attributes": { "PsiPower": 1 }, "addResistances": { "Cryo": 5 },
      "newAbility": {
        "name": "Icicle Palisade", "icon": "icons/icicle_palisade.png", "target": "floor", "range": 5, "radius": 1.2,
        "staminaCost": 9, "cooldown": 6,
        "description": "Ice spikes burst up out of the floor and stay there. Whoever walks through them is cut and supercooled. Steals heat from each enemy caught in the burst.",
        "areaVfx": "KmPalisade", "sound": "audio_licensed/km_palisade.wav",
        "actions": [
          { "do": "damage", "type": "Piercing", "min": 3, "max": 6, "scale": "Smarts+PsiPower", "scaleMult": 0.2, "perRank": 1 },
          { "do": "field", "fieldName": "Icicle Palisade", "turns": 5, "radius": 1.2, "affects": "enemies", "spacing": 1,
            "model": { "mesh": "models/ice_spikes.glb", "scale": 0.6, "offset": [0, 0.23, 0], "wobble": 6, "randomYaw": true, "glow": "#9fe6ff", "glowStrength": 0.25 },
            "actions": [ { "do": "damage", "type": "Piercing", "min": 2, "max": 4, "perRank": 1 },
                         { "do": "damage", "type": "Cryo", "min": 1, "max": 3 },
                         { "do": "effect", "effect": "@Supercooled" } ] },
          { "do": "effect", "to": "self", "effect": "@StolenHeat" } ],
        "perk": { "name": "Hedge of Knives", "damageMult": 1.3 } } },

    { "attributes": { "Smarts": 1, "PsiPower": 1 },
      "newAbility": {
        "base": "Bolt", "name": "Shatterpoint", "icon": "icons/shatterpoint.png", "range": 6, "staminaCost": 11, "cooldown": 2,
        "resetOnKill": true,
        "description": "Find the fault line and strike it. A frozen target breaks apart for heavy damage and its shards fly to the enemies nearby. A kill makes it ready again.",
        "travelVfx": "KmSiphonBolt", "travelSpeed": 16, "impactVfx": "KmShatter", "sound": "sfx/km_shatter.wav",
        "actions": [
          { "do": "chain", "ifTargetHas": "@FrozenSolid", "jumps": 2, "radius": 2.5, "vfx": "KmShatter@0.5",
            "actions": [ { "do": "damage", "type": "Cryo", "min": 3, "max": 5, "perRank": 1 },
                         { "do": "effect", "effect": "@Supercooled", "stacks": 2 } ] },
          { "do": "damage", "type": "Crushing", "min": 3, "max": 6, "scale": "Smarts+PsiPower", "scaleMult": 0.3, "perRank": 1 },
          { "do": "damage", "type": "Crushing", "min": 6, "max": 10, "scale": "Smarts+PsiPower", "scaleMult": 0.3, "perRank": 2,
            "ifTargetHas": "@FrozenSolid", "consume": true } ],
        "perk": { "name": "Fault Line", "damageMult": 1.3 } } },

    { "attributes": { "Smarts": 1, "PsiPower": 1 }, "addResistances": { "Cryo": 10 },
      "newAbility": {
        "name": "Zero Point", "icon": "icons/zero_point.png", "target": "self", "radius": 3,
        "staminaCost": 26, "cooldown": 12,
        "description": "Pull every scrap of heat out of the room at once. Enemies around you are dragged a step closer and supercooled three times over, and you come away with four Stolen Heat. Vent it before it cooks you.",
        "castVfx": "KmZeroPoint", "impactVfx": "KmFrostHit@0.6", "sound": "sfx/km_zero_point.wav",
        "actions": [
          { "do": "pull", "amount": 1 },
          { "do": "damage", "type": "Cryo", "min": 4, "max": 8, "scale": "Smarts+PsiPower", "scaleMult": 0.3, "perRank": 2 },
          { "do": "effect", "effect": "@Supercooled", "stacks": 3 },
          { "do": "effect", "to": "self", "effect": "@StolenHeat", "stacks": 4 } ],
        "perk": { "name": "Absolute", "radiusDelta": 1 } } }
  ]
}
