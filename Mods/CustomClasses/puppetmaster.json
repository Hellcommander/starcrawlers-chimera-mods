          {
            "on": "hit",
            "chance": 25,
            "actions": [
              { "do": "effect", "effect": "@Strings" }
            ]
          }
        ]
      }
    },
    {
      "attributes": {
        "Smarts": 1
      },
      "newAbility": {
        "base": "Bolt",
        "name": "Thread",
        "icon": "puppetmaster_t1.png",
        "staminaCost": 8,
