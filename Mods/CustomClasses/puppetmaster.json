        "radius": 5,
        "staminaCost": 30,
        "cooldown": 16,
        "description": "Snap every thread at once. It hurts in proportion to how tangled they were.",
        "castVfx": "PA_ThoughtLeader_FI.castParticle",
        "impactVfx": "PA_ThoughtLeader_JoinUs.PS_Impact",
        "sound": "audio_licensed/puppet_cut.wav",
        "actions": [
          { "do": "damage", "type": "Psi", "min": 3, "max": 6, "scale": "Savvy", "scaleMult": 0.4, "perRank": 2, "bonusPerStack": 4, "stacksOf": "@Strings", "consumeStacks": true, "ifTargetHas": "@Strings" }
        ],
        "perk": {
          "name": "Final Bow",
          "damageMult": 1.25
        }
      }
    },
    {
      "attributes": {
        "Savvy": 2,
        "Smarts": 1
      },
      "newAbility": {
        "base": "Blast",
        "name": "Tangleweave",
        "icon": "puppetmaster_t6.png",
        "range": 6,
        "radius": 2,
        "staminaCost": 22,
        "cooldown": 12,
        "description": "Cast a whole net of threads over a crowd. For a moment their hands are yours, and nobody gets to do anything clever.",
        "castVfx": "PA_ThoughtLeader_FI.castParticle",
        "impactVfx": "PA_ThoughtLeader_JoinUs.PS_Impact",
        "sound": "sfx/puppet_thread.wav",
        "actions": [
          { "do": "damage", "type": "Psi", "min": 2, "max": 4, "scale": "Savvy", "scaleMult": 0.3, "perRank": 1 },
          { "do": "effect", "effect": "@Strings" },
          { "do": "silence", "turns": 1 }
        ],
        "perk": {
          "name": "Spider's Parlour",
          "addActions": [
            { "do": "effect", "effect": "@Strings" }
          ]
        }
      }
    },
    {
      "attributes": {
        "Savvy": 2,
        "Smarts": 1
      },
      "newAbility": {
        "base": "Passive",
        "name": "Backlash Rigging",
        "icon": "puppetmaster_t7.png",
        "description": "Anyone who lays a hand on you gets a thread tied to it, and a puppet one string short of yours fights the tension in every limb.",
        "procs": [
          {
            "on": "hurt",
            "chance": 50,
            "actions": [
              { "do": "effect", "effect": "@Strings" }
            ]
          },
          {
            "on": "hit",
            "maxPerTurn": 1,
            "when": { "value": "stacks:@Strings", "of": "victim", "atLeast": 3 },
            "vfx": "PA_ThoughtLeader_JoinUs.PS_Impact",
            "actions": [
              { "do": "damage", "type": "Psi", "min": 2, "max": 4, "scale": "Savvy", "scaleMult": 0.25 },
              { "do": "exhaust", "amount": 1 }
            ]
          }
        ]
      }
    }
  ]
