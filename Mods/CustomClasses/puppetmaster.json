        "actions": [
          { "do": "effect", "effect": "@Decoy" }
        ],
        "perk": {
          "name": "Lifelike Puppet",
          "addActions": [
            { "do": "shield", "amount": 8 }
          ]
        }
      }
    },
    {
      "attributes": {
        "Smarts": 2
      },
      "newAbility": {
        "base": "Passive",
        "name": "Marionette Mastery",
