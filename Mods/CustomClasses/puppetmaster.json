        "impactVfx": "PA_ThoughtLeader_JoinUs.PS_Impact",
        "sound": "sfx/puppet_thread.wav",
        "actions": [
          { "do": "damage", "type": "Psi", "min": 1, "max": 3, "scale": "Savvy", "scaleMult": 0.3, "perRank": 1 },
          { "do": "effect", "effect": "@Strings" }
        ],
        "perk": {
          "name": "Silk Thread",
          "damageMult": 1.3
        }
      }
    },
    {
      "attributes": {
        "Savvy": 1
      },
      "newAbility": {
        "base": "Bolt",
        "name": "Dance, Puppet",
        "icon": "puppetmaster_t2.png",
        "cooldown": 6,
        "staminaCost": 15,
        "description": "Yank the threads hard. They stumble, and you tie two more.",
        "impactVfx": "PA_Psykonics_Dominate.castParticle",
        "sound": "event:/Abilities/Misc/Psykonics_Dominate",
        "actions": [
          { "do": "effect", "effect": "@Strings", "stacks": 2 },
          { "do": "effect", "effect": "#Reeling" }
        ],
        "perk": {
          "name": "Jig",
          "cooldownDelta": -2
        }
      }
    },
    {
      "attributes": {
        "Agility": 1
      },
      "newAbility": {
        "base": "Buff",
        "name": "Decoy Puppet",
        "icon": "puppetmaster_t3.png",
        "cooldown": 12,
