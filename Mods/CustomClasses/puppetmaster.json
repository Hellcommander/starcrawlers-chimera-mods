{
  "id": "MOD_Puppetmaster",
  "name": "Puppetmaster",
  "description": "Why fight when they can fight for you? Tie psychic Strings to your enemies; at four strings they're yours, charmed and turned against their friends. Cut the Strings snaps every thread in the room for damage.\n\nMind-control caster built on stacking Strings. Favors [SAV] and [SMT].",
  "archetype": "Intellect",
  "icon": "puppetmaster.png",
  "attributePriorities": {
    "Savvy": 4,
    "Smarts": 3
  },
  "effects": [
    {
      "id": "Strings",
      "name": "Strings",
      "description": "Faint threads of light tug at their limbs.",
      "duration": 5,
      "debuff": true,
      "maxStacks": 4,
      "stats": {
        "Dodge": -3
      },
      "vfx": "EFFECT_ThoughtLeader_Minion",
      "burstAt": 4,
      "burstVfx": "PA_Psykonics_Dominate.castParticle",
      "burstSound": "event:/Abilities/Misc/Psykonics_Dominate",
      "burstActions": [
        { "do": "effect", "effect": "CHARM", "turns": 4 }
      ]
    },
    {
      "id": "Decoy",
      "name": "Puppet Decoy",
      "description": "They're attacking a puppet that looks just like you.",
      "duration": 2,
      "stats": {
        "Dodge": 30
      }
    }
  ],
  "tiers": [
