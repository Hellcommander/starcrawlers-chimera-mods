        "procs": [
          {
            "on": "kill",
            "radius": 3,
            "actions": [
              { "do": "effect", "effect": "@Strings" }
            ]
          }
        ]
      }
    },
    {
      "attributes": {
        "Savvy": 2,
        "Smarts": 1
      },
      "newAbility": {
        "base": "Nova",
