        "procs": [
          {
            "on": "kill",
            "radius": 3,
            "actions": [
              { "do": "effect", "effect": "@Malware", "stacks": 2 }
            ]
          }
        ]
      }
    },
    {
      "attributes": {
        "Smarts": 2,
        "PsiPower": 1
      },
      "newAbility": {
        "base": "Bolt",
        "name": "Kernel Panic",
        "icon": "void_hacker_t5.png",
        "staminaCost": 25,
        "cooldown": 12,
        "description": "Force every bit of malware to execute at once.",
        "impactVfx": "PA_Hacker_Virus_Mindmelt.PS_mindmelt_impact",
        "sound": "sfx/voidhacker_panic.wav",
        "actions": [
          { "do": "damage", "type": "Energy", "min": 3, "max": 6, "scale": "Smarts", "scaleMult": 0.5, "perRank": 2, "bonusPerStack": 3, "stacksOf": "@Malware", "consumeStacks": true },
          { "do": "damage", "type": "Void", "min": 2, "max": 4 }
        ],
        "perk": {
          "name": "Blue Screen",
          "damageMult": 1.25
        }
      }
    },
    {
      "attributes": {
        "Smarts": 2,
        "Toughness": 1
      },
      "newAbility": {
        "base": "Buff",
        "name": "Turncoat Turret",
        "icon": "void_hacker_t6.png",
        "instant": false,
        "staminaCost": 25,
        "cooldown": 20,
        "description": "Pull a security turret out of the station's inventory and flash it with your own firmware. Every round it fires carries a payload. Use it again while it stands to patch it back up.",
        "castVfx": "PA_Hacker_Command.PS_heal",
        "sound": "event:/Abilities/Hacker/Hacker_Hack",
        "actions": [
          { "do": "summon", "to": "self", "creature": "PA_Engineer_Turret.characterPrefab", "summonName": "Hijacked Sentry", "model": { "mesh": "models/hijacked_sentry.glb", "height": 1.2, "keepParticles": false }, "summonGroup": "HijackedSentry", "turns": 15, "maxSummons": 1, "effect": "@Rootkit", "unlessSummonAlive": "group:HijackedSentry" },
          { "do": "heal", "to": "summons", "ifSummonAlive": "group:HijackedSentry", "amount": 10, "scale": "Smarts", "scaleMult": 0.5 }
        ],
        "perk": {
          "name": "Admin Rights",
          "cooldownDelta": -6
        }
      }
    },
    {
      "attributes": {
        "Smarts": 2,
        "PsiPower": 1
      },
      "newAbility": {
        "base": "Passive",
        "name": "Segmentation Fault",
        "icon": "void_hacker_t7.png",
        "description": "Infections near you start leaking into each other's memory. Every infected system around you takes damage each turn, and some of it spreads.",
        "procs": [
          {
            "on": "turn",
            "radius": 3,
            "actions": [
              { "do": "damage", "type": "Energy", "min": 1, "max": 3, "scale": "Smarts", "scaleMult": 0.2, "ifTargetHas": "@Malware" },
              { "do": "effect", "effect": "@Malware", "chance": 25, "ifTargetHas": "@Malware" }
            ]
          },
          {
            "on": "crit",
            "actions": [
              { "do": "effect", "effect": "@Malware", "stacks": 2 }
            ]
          }
        ]
      }
    }
