        "cooldown": 5,
        "staminaCost": 15,
        "description": "Self-replicating, self-delivering, self-satisfied.",
        "impactVfx": "PA_Hacker_Virus_Snowcrash.PS_snowcrash_impact",
        "sound": "event:/Abilities/Hacker/Hacker_Scramble",
        "actions": [
          {
            "do": "chain",
            "jumps": 3,
            "radius": 3.5,
            "actions": [
              { "do": "effect", "effect": "@Malware" },
              { "do": "damage", "type": "Energy", "min": 1, "max": 2 }
            ]
          }
        ],
        "perk": {
          "name": "Botnet",
          "addActions": [
            { "do": "effect", "effect": "#Shocked" }
          ]
        }
      }
    },
    {
      "attributes": {
        "Toughness": 1,
        "Smarts": 1
      },
      "newAbility": {
        "base": "Buff",
        "name": "Quarantine",
        "icon": "void_hacker_t3.png",
        "cooldown": 14,
