        "castVfx": "PA_Hacker_Command.PS_heal",
        "sound": "event:/Abilities/Hacker/Hacker_Hack",
        "actions": [
          { "do": "shield", "amount": 8, "scale": "Smarts", "scaleMult": 0.5 },
          { "do": "cleanse" }
        ],
        "perk": {
          "name": "Hardened Kernel",
          "cooldownDelta": -5
        }
      }
    },
    {
      "attributes": {
        "Smarts": 2
      },
      "newAbility": {
        "base": "Passive",
