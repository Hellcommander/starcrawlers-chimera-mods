        "procs": [
          {
            "on": "hit",
            "chance": 30,
            "actions": [
              { "do": "effect", "effect": "@Malware" }
            ]
          }
        ]
      }
    },
    {
      "attributes": {
        "Smarts": 1
      },
      "newAbility": {
        "base": "Bolt",
        "name": "Inject",
        "icon": "void_hacker_t1.png",
        "staminaCost": 8,
        "description": "Push a payload straight into their nervous system.",
        "impactVfx": "PA_Hacker_Hack.hackParticle",
        "sound": "sfx/voidhacker_inject.wav",
        "actions": [
          { "do": "damage", "type": "Energy", "min": 1, "max": 3, "scale": "Smarts", "scaleMult": 0.3, "perRank": 1 },
          { "do": "effect", "effect": "@Malware" }
        ],
        "perk": {
          "name": "Double Payload",
          "addActions": [
            { "do": "effect", "effect": "@Malware" }
          ]
        }
      }
    },
    {
      "attributes": {
        "PsiPower": 1
      },
      "newAbility": {
        "base": "Bolt",
        "name": "Worm",
