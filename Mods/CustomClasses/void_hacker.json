{
  "id": "MOD_VoidHacker",
  "name": "Void Hacker",
  "description": "Found a backdoor into reality and kept typing. Infect targets with Malware that stacks up until their systems crash, stunned and sparking, then let Worm carry the infection through the whole crowd.\n\nStacking malware with a crash at 5 stacks. Favors [SMT] and [PSI].",
  "archetype": "Intellect",
  "icon": "void_hacker.png",
  "attributePriorities": {
    "Smarts": 4,
    "PsiPower": 2
  },
  "effects": [
    {
      "id": "Malware",
      "name": "Malware",
      "description": "Running processes: way too many.",
      "duration": 5,
      "debuff": true,
      "maxStacks": 5,
      "dot": {
        "type": "Energy",
        "min": 1,
        "max": 1
      },
      "vfx": "EFFECT_Hacker_Virus_Snowcrash",
      "burstAt": 5,
      "burstVfx": "PA_Hacker_Virus_Mindmelt.PS_mindmelt_impact",
      "burstSound": "sfx/voidhacker_crash.wav",
      "burstActions": [
        { "do": "stun", "turns": 2 },
        { "do": "damage", "type": "Energy", "min": 4, "max": 8, "scale": "Smarts", "scaleMult": 0.4 }
      ]
    },
    {
      "id": "Rootkit",
      "name": "Hijacked Firmware",
      "description": "Its targeting still says station security. Its payload says otherwise.",
      "duration": -1,
      "damageTakenMult": 0.8,
      "procs": [
        {
          "on": "hit",
          "actions": [
            { "do": "effect", "effect": "@Malware" }
          ]
        }
      ]
    }
  ],
  "tiers": [
    {
      "attributes": {
        "Smarts": 1
      },
      "newAbility": {
        "base": "Passive",
        "name": "Backdoor",
        "icon": "void_hacker_t0.png",
