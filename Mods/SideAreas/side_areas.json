    "anomalies": [
      { "id": "blackout", "name": "Blackout", "hard": true, "weight": 10,
        "text": "Most of the lights are dead. You're harder to spot in the dark, and so is everything waiting in it.",
        "lights": { "off": 0.75, "ambient": 0.35 }, "playerEffect": "InTheDark", "enemyEffect": "BlindSpots" },
      { "id": "gas", "name": "Gas Leak", "hard": true, "weight": 10,
        "text": "Ruptured lines have flooded several rooms with toxic gas.",
        "hazards": { "id": "HAZARD_Gas", "rooms": [3, 4], "spread": true, "turns": 999 } },
      { "id": "lockdown", "name": "Lockdown", "hard": true, "weight": 10,
        "text": "Security has locked half the doors, tighter than usual. Pick them, bash them, or find another way.",
        "doors": { "lock": 0.5, "pick": -20, "bash": -15 } },
      { "id": "infestation", "name": "Infestation", "hard": true, "weight": 9, "notWith": ["quiet"],
        "text": "Something got loose in here and bred. Extra creatures roam the rooms.",
        "spawn": { "count": 5, "perFloor": 1, "maxExtra": 6, "poolStep": 2, "pools": [
          ["MUTT_BASIC", "MUTT_PUP", "WORM_BASIC", "Slime_Bio"],
          ["MUTT_WOLF", "WORM_BIO", "Slime_Electric", "Ooze_Amoebic", "MUTT_UNSTABLE"],
          ["MUTT_HELL", "WORM_FIRE", "WORM_SHOCK", "WORM_VOID", "Slime_Incineron", "Ooze_Pollutant"] ] } },
      { "id": "collapse", "name": "Collapsing Echo", "hard": true, "weight": 8,
        "text": "The echo is coming apart. Get out before it does, or it throws you out the hard way.",
        "timer": { "turns": 50, "warn": [20, 10, 5], "damage": 0.25 } },
      { "id": "storm", "name": "Static Storm", "hard": true, "weight": 8,
        "text": "Discharges arc across the floor around you every few turns.",
        "pulse": { "chance": 0.25, "hazard": "HAZARD_Shock", "turns": 2, "tiles": 2, "onYou": 0.3, "text": "Static arcs across the floor." } },
      { "id": "garrison", "name": "Reinforced Garrison", "hard": true, "weight": 9, "notWith": ["quiet"],
        "text": "Security doubled the shift: many of the guards here are veterans.",
        "enemyEffect": "Garrison", "enemyChance": 0.4 },
      { "id": "richseam", "name": "Rich Seam", "hard": false, "weight": 8,
        "text": "This echo is full of things worth taking: extra caches, and you find more in everything.",
        "playerEffect": "RichSeam", "caches": { "count": 2, "items": 2, "rarity": "Rare" } },
      { "id": "reliquary", "name": "Reliquary", "hard": false, "weight": 0, "extraChance": 0.1, "vaultGrade": 2,
        "text": "The vault here is something special: two grades higher, and its warden knows it." },

      { "id": "alarmnet", "name": "Alarm Grid", "hard": true, "weight": 8,
        "text": "The security grid in here still works. Once anything sees you, responders arrive in waves from the far side.",
        "alarm": { "start": 1, "every": 8, "waves": 3, "size": 2, "whenSpotted": true, "text": "Responders pour in from the far side of the echo." } },
      { "id": "stalker", "name": "Stalker", "hard": true, "weight": 7, "minFloor": 1,
        "text": "Something in here hunts. Give it time and it finds your trail.",
        "hunter": { "after": 20, "health": 3.5, "name": "Stalker", "drop": "Epic", "text": "Something has your scent, and it's coming." } },
      { "id": "coolant", "name": "Coolant Breach", "hard": true, "weight": 8, "notWith": ["gas"],
        "text": "Burst coolant lines have frozen several rooms solid, and the cold gets into everything.",
        "hazards": { "id": "HAZARD_Cryo", "rooms": [3, 4], "spread": true, "turns": 999 }, "playerEffect": "Chilled" },
      { "id": "voidbleed", "name": "Void Bleed", "hard": true, "weight": 6, "minFloor": 2, "notWith": ["storm"],
        "text": "The echo is thin here. Now and then it tears open right beside you.",
        "pulse": { "chance": 0.18, "hazard": "HAZARD_VoidRift", "turns": 2, "tiles": 1, "onYou": 0.15, "text": "The echo tears open beside you.", "color": "#B07CFF" } },
      { "id": "sentries", "name": "Sentry Grid", "hard": true, "weight": 7,
        "text": "Automated turrets were left standing guard, and nobody turned them off.",
        "spawn": { "ids": ["Enemy_Engineer_Turret"], "count": 3, "perFloor": 1, "maxExtra": 3, "name": "Sentry" } },
      { "id": "stimhaze", "name": "Stim Haze", "hard": true, "weight": 6,
        "text": "A cracked stim tank has dosed the air. You hit harder, and so does everything else in here.",
        "playerEffect": "StimHaze", "enemyEffect": "StimHaze" },
      { "id": "stores", "name": "Forgotten Stores", "hard": false, "weight": 8,
        "text": "Supply lockers nobody emptied: meds and consumables scattered around the echo.",
        "caches": { "count": 3, "items": 2, "rarity": "Rare", "type": "Consumable" } },
      { "id": "quiet", "name": "Skeleton Shift", "hard": false, "weight": 7,
        "text": "Most of the shift never came back. Fewer guards, spread thin.",
        "thin": 0.4 }
    ],

