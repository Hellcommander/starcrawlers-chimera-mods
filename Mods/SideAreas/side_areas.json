    "effects": [
      { "id": "StimHaze", "name": "Stim Haze", "icon": "icons/stim_haze.png", "duration": -1,
        "description": "Combat stims hang in the air. Everyone hits harder.", "damageDealtMult": 1.25 },
      { "id": "Chilled", "name": "Chilled", "icon": "icons/chilled.png", "duration": -1, "debuff": true,
        "description": "The coolant has got into your joints.", "stats": { "Dodge": -5, "Agility": -1 } },
      { "id": "Armored", "name": "Armored", "icon": "icons/armored.png", "duration": -1,
        "description": "Plated over. Takes a quarter less damage.", "damageTakenMult": 0.75 },
      { "id": "Frenzied", "name": "Frenzied", "icon": "icons/frenzied.png", "duration": -1,
        "description": "Hits much harder, and doesn't care what it costs.", "damageDealtMult": 1.3, "damageTakenMult": 1.1 },
      { "id": "Hulking", "name": "Hulking", "icon": "icons/hulking.png", "duration": -1,
        "description": "Twice the size it should be.", "stats": { "Armor": 2 } },
      { "id": "Shrouded", "name": "Shrouded", "icon": "icons/shrouded.png", "duration": -1,
        "description": "Hard to pin down: a cloak, a blur, a trick of the light.", "stats": { "Dodge": 15, "Stealth": 15 } },
      { "id": "Mending", "name": "Mending", "icon": "icons/mending.png", "duration": -1,
        "description": "Knits itself back together every turn.", "stats": { "HealthRegen": 4 } },
      { "id": "Rival", "name": "Rival Crawler", "icon": "icons/rival.png", "duration": -1,
        "description": "Another crawler after the same loot. Experienced, well kitted, and not sharing.", "damageDealtMult": 1.15, "damageTakenMult": 0.85 }
    ],

    "rosters": [
      { "id": "corpsec", "name": "CorpSec Detail", "color": "#6FB7FF", "weight": 12,
        "text": "Chimera security got here first and set up a post.",
        "tiers": [ ["CORPSEC_GUARD_PISTOL", "CORPSEC_GUARD_MELEE", "CORPSEC_DRONE"],
                   ["CORPSEC_TROOPER", "CORPSEC_SHARPSHOOTER", "CORPSEC_FLYER", "CORPSEC_SPIDER"],
                   ["CORPSEC_COMMANDO", "Enemy_CorpSec_Drone_MkII", "Enemy_CorpSec_FlyerMkII", "CORPSEC_TARANTULA", "CORPSEC_WIDOW"] ] },
      { "id": "machines", "name": "Rogue Machines", "color": "#FFC35C", "weight": 10,
        "text": "The service bots in here stopped taking orders a long time ago.",
        "tiers": [ ["WorkerBot", "CleanerBot", "LobbyBot", "Greasebot"],
                   ["LoaderBot", "MinerBot", "CleanerBot_Berserk", "ChefBot"],
                   ["LoaderBot_Cleaver", "Enemy_Engineer_Junker", "Enemy_Engineer_Shieldbot", "Enemy_Geotechnician_Bomb"] ] },
      { "id": "labstaff", "name": "Lab Staff", "color": "#9FE08A", "weight": 9,
        "text": "A research team kept working in here, and kept their specimens close.",
        "tiers": [ ["ChemLab_LabTech", "ChemLab_LabTech_Ranged", "Slime_Bio"],
                   ["ChemLab_LabTech_Scientist", "ChemLab_LabTech_Specialist", "LABTECH_SLIME_WRANGLER", "Slime_Electric"],
                   ["BIOLAB_BIOSLIME_WRANGLER", "Slime_Catalyst", "Slime_Incineron", "Ooze_Pollutant"] ] },
      { "id": "production", "name": "Night Shift", "color": "#FF9F6A", "weight": 7,
        "text": "The production line never stopped, and neither did the people running it.",
        "tiers": [ ["Enemy_Worker_Food_Melee", "Enemy_Worker_Beverage_Ranged", "WorkerBot"],
                   ["Enemy_Scientist_Food", "Enemy_Scientist_Beverage", "ChefBot", "Enemy_Worker_Food_Melee"],
                   ["Enemy_Scientist_Food", "Enemy_Scientist_Beverage", "LoaderBot_Cleaver", "ChefBot"] ] },
      { "id": "digcrew", "name": "Dig Crew", "color": "#C9A06A", "weight": 7, "minFloor": 1,
        "text": "Geotechs and their machines, still digging, and whatever they dug up.",
        "tiers": [ ["MinerBot", "WORM_BASIC", "Enemy_Geotechnician_Ranged"],
                   ["Enemy_Geotechnician_Ranged", "Enemy_Geotechnician_Bomb", "WORM_FIRE", "WORM_SHOCK"],
                   ["Enemy_Geotechnician_Bomb", "WORM_VOID", "WORM_FIRE", "MUTT_HELL"] ] },
      { "id": "pirates", "name": "Scrap Pirates", "color": "#E070A0", "weight": 8,
        "text": "Pirate salvage bots are stripping this place, and they don't like competition.",
        "tiers": [ ["NPC_PirateBot", "Greasebot"],
                   ["NPC_PirateBot", "NPC_PirateBot_Ravager", "Greasebot"],
                   ["NPC_PirateBot_Ravager", "NPC_PirateBot", "Enemy_Engineer_Junker"] ] },
      { "id": "specimens", "name": "Escaped Specimens", "color": "#B07CFF", "weight": 9,
